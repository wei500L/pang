# Development environment only.
# Copy to .env, then fill the three required values.
# Production uses docker-compose.yml + image defaults, not this file.

# Required
VOICE_AUTH_USERNAME=admin
VOICE_AUTH_PASSWORD=replace-with-a-long-random-password
# Development may omit these and use Cloudflare's always-pass test keys.
VOICE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VOICE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# openssl rand -hex 32
VOICE_TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output

# Runtime
VOICE_ENV=development
VOICE_LISTEN_ADDR=0.0.0.0:8090
VOICE_TLS=false
VOICE_SKIP_SSL_VERIFY=false

# Paths
VOICE_DATA_DIR=./data
VOICE_DATABASE_FILE=./data/voice.db
VOICE_STATIC_DIR=./static

# Optional process TLS (only when VOICE_TLS=true)
# VOICE_TLS_CERT=
# VOICE_TLS_KEY=
# VOICE_TLS_CERT_DIR=./data/certs

# Session / login
VOICE_AUTH_SESSION_TTL_SECONDS=43200
VOICE_LOGIN_MAX_FAILURES=8
VOICE_LOGIN_WINDOW_SECONDS=900
VOICE_LOGIN_LOCKOUT_SECONDS=900
VOICE_PUBLIC_SESSION_RATE_LIMIT_PER_MINUTE=300
VOICE_PUBLIC_WRITE_RATE_LIMIT_PER_MINUTE=3000
# Set true only when the origin accepts traffic exclusively from Cloudflare.
VOICE_TRUST_CLOUDFLARE_IP=false
VOICE_SESSION_TTL_SECONDS=180
VOICE_MAX_ACCOUNT_ATTEMPTS=4

# Upstream transport (local default: tls-client)
VOICE_UPSTREAM_TRANSPORT=tls-client
VOICE_TLS_PROFILE=chrome_120
# Only needed when VOICE_UPSTREAM_TRANSPORT=curl-impersonate
# VOICE_IMPERSONATE=edge_101
# VOICE_CURL_IMPERSONATE_BIN=

# Logging
VOICE_LOG_FORMAT=json
VOICE_LOG_LEVEL=info

# "另一种可能 · 生活的一帧" scene generation (optional, personal mode only)
# Two fully separate providers and credentials. Neither falls back to the
# other, and neither ever uses the ChatGPT Web account pool access tokens.
# Without a complete pair the main service still starts; voice/chat/recordings
# are unaffected and scene draft/generation endpoints answer 503.

# Scene text orchestration: candidate moments + SceneBrief (chat completions).
VOICE_SCENE_AI_BASE_URL=https://api.openai.com/v1
VOICE_SCENE_AI_API_KEY=
VOICE_SCENE_TEXT_MODEL=gpt-4o-mini

# Production OpenAI-compatible Images API (generations only).
# Requests are fixed at size=1536x1024, quality=standard, n=1 and never send
# response_format/output_format. Images are aspect-validated (3:2 within 0.5%)
# and Lanczos-normalized to exactly 1536x1024 before being stored.
IMAGE_API_BASE_URL=https://api.openai.com
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_REQUEST_TIMEOUT_SECONDS=180
IMAGE_MAX_BYTES=33554432

# Scene worker (gateway-side scheduling, not vendor credentials)
VOICE_SCENE_GENERATION_CONCURRENCY=2
VOICE_SCENE_REQUEST_TIMEOUT_SECONDS=180
