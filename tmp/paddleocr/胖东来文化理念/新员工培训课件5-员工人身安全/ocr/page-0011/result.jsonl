{"logId": "bc2d3cdb-b5e2-42d4-b2b4-745f741dd390", "result": {"layoutParsingResults": [{"prunedResult": {"page_count": null, "width": 1190, "height": 1684, "model_settings": {"use_doc_preprocessor": false, "use_layout_detection": true, "use_chart_recognition": false, "use_seal_recognition": false, "use_ocr_for_image_block": false, "format_block_content": false, "merge_layout_blocks": true, "markdown_ignore_labels": ["number", "footnote", "header", "header_image", "footer", "footer_image", "aside_text"], "return_layout_polygon_points": true}, "parsing_res_list": [{"block_label": "text", "block_content": "1、骑乘摩托车、踏板电动车、电动自行车正确佩戴头盔，晚上出行佩戴好反光背心；", "block_bbox": [300, 183, 914, 234], "block_id": 0, "block_order": 1, "group_id": 0, "block_polygon_points": [[300.0, 183.0], [914.0, 183.0], [914.0, 234.0], [300.0, 234.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [301, 238, 462, 345], "block_id": 1, "block_order": null, "group_id": 1, "block_polygon_points": [[301.0, 238.0], [462.0, 238.0], [462.0, 345.0], [301.0, 345.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [503, 236, 656, 345], "block_id": 2, "block_order": null, "group_id": 2, "block_polygon_points": [[503.0, 236.0], [656.0, 236.0], [656.0, 345.0], [503.0, 345.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [720, 237, 888, 344], "block_id": 3, "block_order": null, "group_id": 3, "block_polygon_points": [[720.0, 237.0], [888.0, 237.0], [888.0, 344.0], [720.0, 344.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [306, 358, 476, 471], "block_id": 4, "block_order": null, "group_id": 4, "block_polygon_points": [[306.0, 358.0], [476.0, 358.0], [476.0, 471.0], [306.0, 471.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [501, 360, 672, 473], "block_id": 5, "block_order": null, "group_id": 5, "block_polygon_points": [[501.0, 360.0], [672.0, 360.0], [672.0, 473.0], [501.0, 473.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [721, 359, 887, 473], "block_id": 6, "block_order": null, "group_id": 6, "block_polygon_points": [[721.0, 359.0], [887.0, 359.0], [887.0, 473.0], [721.0, 473.0]]}, {"block_label": "text", "block_content": "2、驾驶及乘坐公司车辆及私家车扣好安全带。", "block_bbox": [301, 478, 703, 503], "block_id": 7, "block_order": 2, "group_id": 7, "block_polygon_points": [[301.0, 478.0], [703.0, 478.0], [703.0, 503.0], [301.0, 503.0]]}, {"block_label": "text", "block_content": "注意事项：", "block_bbox": [301, 503, 401, 524], "block_id": 8, "block_order": 3, "group_id": 8, "block_polygon_points": [[301.0, 503.0], [400.0, 503.0], [400.0, 523.0], [301.0, 523.0]]}, {"block_label": "text", "block_content": "1、不允许穿拖鞋、高跟鞋驾驶机动车；", "block_bbox": [301, 526, 652, 551], "block_id": 9, "block_order": 4, "group_id": 9, "block_polygon_points": [[301.0, 526.0], [646.0, 526.0], [646.0, 550.0], [301.0, 550.0]]}, {"block_label": "text", "block_content": "2、行驶途中不允许接打电话：", "block_bbox": [301, 550, 571, 573], "block_id": 10, "block_order": 5, "group_id": 10, "block_polygon_points": [[301.0, 550.0], [571.0, 550.0], [571.0, 573.0], [301.0, 573.0]]}, {"block_label": "text", "block_content": "3、机动车不允许乱停乱放、逆向行驶、超速、疲劳驾驶。", "block_bbox": [300, 572, 802, 599], "block_id": 11, "block_order": 6, "group_id": 11, "block_polygon_points": [[300.0, 572.0], [802.0, 572.0], [802.0, 599.0], [300.0, 599.0]]}, {"block_label": "footer_image", "block_content": "", "block_bbox": [939, 596, 1123, 641], "block_id": 12, "block_order": null, "group_id": 12, "block_polygon_points": [[939.0, 596.0], [1123.0, 596.0], [1123.0, 641.0], [939.0, 641.0]]}, {"block_label": "paragraph_title", "block_content": "生活篇--品行要求", "block_bbox": [93, 678, 308, 712], "block_id": 13, "block_order": 7, "group_id": 13, "block_polygon_points": [[93.0, 678.0], [308.0, 678.0], [308.0, 712.0], [93.0, 712.0]]}, {"block_label": "paragraph_title", "block_content": "DÍ", "block_bbox": [120, 826, 193, 864], "block_id": 14, "block_order": 8, "group_id": 14, "block_polygon_points": [[120.0, 826.0], [193.0, 826.0], [193.0, 864.0], [120.0, 864.0]]}, {"block_label": "paragraph_title", "block_content": "五、品行：", "block_bbox": [147, 893, 279, 920], "block_id": 15, "block_order": 9, "group_id": 15, "block_polygon_points": [[147.0, 893.0], [279.0, 893.0], [279.0, 920.0], [147.0, 920.0]]}, {"block_label": "text", "block_content": "1、不认同、不遵守公司企业文化：", "block_bbox": [95, 925, 406, 950], "block_id": 16, "block_order": 10, "group_id": 16, "block_polygon_points": [[95.0, 925.0], [406.0, 925.0], [406.0, 950.0], [95.0, 950.0]]}, {"block_label": "text", "block_content": "2、随地吐痰、乱扔垃圾；", "block_bbox": [96, 950, 319, 975], "block_id": 17, "block_order": 11, "group_id": 17, "block_polygon_points": [[96.0, 950.0], [319.0, 950.0], [319.0, 975.0], [96.0, 975.0]]}, {"block_label": "text", "block_content": "3、拾遗物品不上交，据为己有；", "block_bbox": [97, 975, 387, 998], "block_id": 18, "block_order": 12, "group_id": 18, "block_polygon_points": [[97.0, 975.0], [387.0, 975.0], [387.0, 998.0], [97.0, 998.0]]}, {"block_label": "text", "block_content": "4、煽动员工闹事或怠工；", "block_bbox": [96, 999, 328, 1023], "block_id": 19, "block_order": 13, "group_id": 19, "block_polygon_points": [[96.0, 999.0], [328.0, 999.0], [328.0, 1023.0], [96.0, 1023.0]]}, {"block_label": "text", "block_content": "5、拉帮结派、搬弄是非、影响工作、破坏团结；", "block_bbox": [95, 1022, 525, 1048], "block_id": 20, "block_order": 14, "group_id": 20, "block_polygon_points": [[95.0, 1022.0], [525.0, 1022.0], [525.0, 1048.0], [95.0, 1048.0]]}, {"block_label": "text", "block_content": "6、对向上级反映情况的人打击报复：", "block_bbox": [96, 1047, 427, 1072], "block_id": 21, "block_order": 15, "group_id": 21, "block_polygon_points": [[96.0, 1047.0], [427.0, 1047.0], [427.0, 1072.0], [96.0, 1072.0]]}, {"block_label": "text", "block_content": "7、公然违抗上级主管或故意刁难下属；", "block_bbox": [96, 1072, 446, 1096], "block_id": 22, "block_order": 16, "group_id": 22, "block_polygon_points": [[96.0, 1072.0], [446.0, 1072.0], [446.0, 1096.0], [96.0, 1096.0]]}, {"block_label": "text", "block_content": "8、不良生活作风、违反公共道德，给公司造成不良影响；", "block_bbox": [96, 1095, 604, 1120], "block_id": 23, "block_order": 17, "group_id": 23, "block_polygon_points": [[96.0, 1095.0], [96.0, 1119.0], [598.0, 1119.0], [598.0, 1095.0]]}, {"block_label": "text", "block_content": "9、造谣、侮辱、猥亵、威胁或勒索同事；", "block_bbox": [96, 1120, 472, 1144], "block_id": 24, "block_order": 18, "group_id": 24, "block_polygon_points": [[96.0, 1120.0], [472.0, 1120.0], [472.0, 1144.0], [96.0, 1144.0]]}, {"block_label": "text", "block_content": "10、盗窃或故意损坏他人财物；", "block_bbox": [96, 1144, 377, 1167], "block_id": 25, "block_order": 19, "group_id": 25, "block_polygon_points": [[96.0, 1144.0], [377.0, 1144.0], [377.0, 1167.0], [96.0, 1167.0]]}, {"block_label": "text", "block_content": "11、对盗窃的违规行为知情不报，不做规劝、互相包庇；", "block_bbox": [96, 1167, 595, 1193], "block_id": 26, "block_order": 20, "group_id": 26, "block_polygon_points": [[96.0, 1167.0], [595.0, 1167.0], [595.0, 1193.0], [96.0, 1193.0]]}, {"block_label": "text", "block_content": "12、私自索要、接受厂家、供应商的赠品；", "block_bbox": [96, 1192, 478, 1217], "block_id": 27, "block_order": 21, "group_id": 27, "block_polygon_points": [[96.0, 1192.0], [478.0, 1192.0], [478.0, 1217.0], [96.0, 1217.0]]}, {"block_label": "text", "block_content": "13、故意隐瞒、弄虚作假或为弄虚作假者提供方便；", "block_bbox": [96, 1217, 556, 1242], "block_id": 28, "block_order": 22, "group_id": 28, "block_polygon_points": [[96.0, 1217.0], [556.0, 1217.0], [556.0, 1242.0], [96.0, 1242.0]]}, {"block_label": "text", "block_content": "14、聚众赌博，吸毒、藏毒、贩卖毒品；", "block_bbox": [97, 1241, 456, 1265], "block_id": 29, "block_order": 23, "group_id": 29, "block_polygon_points": [[97.0, 1241.0], [456.0, 1241.0], [456.0, 1265.0], [97.0, 1265.0]]}, {"block_label": "text", "block_content": "15、参与涉黑组织、传销组织，不合法投资、担保、放贷和借贷；", "block_bbox": [96, 1263, 674, 1290], "block_id": 30, "block_order": 24, "group_id": 30, "block_polygon_points": [[96.0, 1263.0], [674.0, 1263.0], [674.0, 1290.0], [96.0, 1290.0]]}, {"block_label": "text", "block_content": "16、向他人相互借款金额超过一万元以上（包含一万元）（家庭人员医疗应急除外，其它特殊原因向公司申请）", "block_bbox": [96, 1292, 588, 1336], "block_id": 31, "block_order": 25, "group_id": 31, "block_polygon_points": [[96.0, 1292.0], [588.0, 1292.0], [588.0, 1336.0], [96.0, 1336.0]]}, {"block_label": "text", "block_content": "17、因触犯国家法律被司法机关处理。", "block_bbox": [96, 1337, 432, 1362], "block_id": 32, "block_order": 26, "group_id": 32, "block_polygon_points": [[96.0, 1337.0], [432.0, 1337.0], [432.0, 1362.0], [96.0, 1362.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [731, 919, 903, 1092], "block_id": 33, "block_order": null, "group_id": 33, "block_polygon_points": [[731.0, 919.0], [903.0, 919.0], [903.0, 1092.0], [731.0, 1092.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [931, 920, 1102, 1091], "block_id": 34, "block_order": null, "group_id": 34, "block_polygon_points": [[931.0, 920.0], [1102.0, 920.0], [1102.0, 1091.0], [931.0, 1091.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [730, 1130, 906, 1311], "block_id": 35, "block_order": null, "group_id": 35, "block_polygon_points": [[730.0, 1130.0], [906.0, 1130.0], [906.0, 1311.0], [730.0, 1311.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [930, 1130, 1107, 1313], "block_id": 36, "block_order": null, "group_id": 36, "block_polygon_points": [[930.0, 1130.0], [1107.0, 1130.0], [1107.0, 1313.0], [930.0, 1313.0]]}, {"block_label": "footer_image", "block_content": "", "block_bbox": [938, 1334, 1122, 1378], "block_id": 37, "block_order": null, "group_id": 37, "block_polygon_points": [[938.0, 1334.0], [1122.0, 1334.0], [1122.0, 1378.0], [938.0, 1378.0]]}], "layout_det_res": {"boxes": [{"cls_id": 22, "label": "text", "score": 0.8373613357543945, "coordinate": [300, 183, 914, 234], "order": 1, "polygon_points": [[300.0, 183.0], [914.0, 183.0], [914.0, 234.0], [300.0, 234.0]]}, {"cls_id": 14, "label": "image", "score": 0.9269223213195801, "coordinate": [301, 238, 462, 345], "order": null, "polygo