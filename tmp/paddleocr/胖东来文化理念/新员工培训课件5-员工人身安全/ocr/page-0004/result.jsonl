ntent": "", "block_bbox": [243, 415, 502, 580], "block_id": 6, "block_order": null, "group_id": 6, "block_polygon_points": [[243.0, 415.0], [502.0, 415.0], [502.0, 580.0], [243.0, 580.0]]}, {"block_label": "vision_footnote", "block_content": "自助取款机取钱时", "block_bbox": [293, 596, 440, 623], "block_id": 7, "block_order": null, "group_id": 7, "block_polygon_points": [[293.0, 596.0], [440.0, 596.0], [440.0, 623.0], [293.0, 623.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [688, 415, 941, 578], "block_id": 8, "block_order": null, "group_id": 8, "block_polygon_points": [[688.0, 415.0], [941.0, 415.0], [941.0, 578.0], [688.0, 578.0]]}, {"block_label": "vision_footnote", "block_content": "行人稀少、环境阴暗、偏僻的地方", "block_bbox": [702, 596, 906, 645], "block_id": 9, "block_order": null, "group_id": 9, "block_polygon_points": [[702.0, 596.0], [906.0, 596.0], [906.0, 645.0], [702.0, 645.0]]}, {"block_label": "paragraph_title", "block_content": "DÍ", "block_bbox": [120, 706, 193, 744], "block_id": 10, "block_order": 3, "group_id": 10, "block_polygon_points": [[120.0, 706.0], [193.0, 706.0], [193.0, 744.0], [120.0, 744.0]]}, {"block_label": "paragraph_title", "block_content": "抢劫事件的预防及处理方法：", "block_bbox": [124, 790, 415, 822], "block_id": 11, "block_order": 4, "group_id": 11, "block_polygon_points": [[124.0, 790.0], [415.0, 790.0], [415.0, 822.0], [124.0, 822.0]]}, {"block_label": "text", "block_content": "1、上下班途中不要戴耳机或者拨打电话：", "block_bbox": [125, 846, 496, 875], "block_id": 12, "block_order": 5, "group_id": 12, "block_polygon_points": [[125.0, 846.0], [496.0, 846.0], [496.0, 875.0], [125.0, 875.0]]}, {"block_label": "text", "block_content": "2、到自动取款机取钱时，注意观察周围情况：", "block_bbox": [124, 885, 535, 915], "block_id": 13, "block_order": 6, "group_id": 13, "block_polygon_points": [[124.0, 885.0], [535.0, 885.0], [535.0, 915.0], [124.0, 915.0]]}, {"block_label": "text", "block_content": "3、在外租房的，和同事合租套房，不要租独门独院或者位置偏僻的房子；", "block_bbox": [124, 925, 771, 955], "block_id": 14, "block_order": 7, "group_id": 14, "block_polygon_points": [[124.0, 925.0], [771.0, 925.0], [771.0, 955.0], [124.0, 955.0]]}, {"block_label": "text", "block_content": "4、外出不要携带过多的现金和显眼的贵重物品；", "block_bbox": [125, 964, 556, 993], "block_id": 15, "block_order": 8, "group_id": 15, "block_polygon_points": [[125.0, 964.0], [556.0, 964.0], [556.0, 993.0], [125.0, 993.0]]}, {"block_label": "text", "block_content": "5、现金或贵重物品最好贴身携带；", "block_bbox": [126, 1003, 438, 1032], "block_id": 16, "block_order": 9, "group_id": 16, "block_polygon_points": [[126.0, 1003.0], [438.0, 1003.0], [438.0, 1032.0], [126.0, 1032.0]]}, {"block_label": "text", "block_content": "6、出门上街，应结伴而行，避免独行晚归；", "block_bbox": [126, 1043, 515, 1072], "block_id": 17, "block_order": 10, "group_id": 17, "block_polygon_points": [[126.0, 1043.0], [515.0, 1043.0], [515.0, 1072.0], [126.0, 1072.0]]}, {"block_label": "text", "block_content": "7、不去行人稀少、环境阴暗、偏僻的地方；", "block_bbox": [126, 1081, 516, 1111], "block_id": 18, "block_order": 11, "group_id": 18, "block_polygon_points": [[126.0, 1081.0], [516.0, 1081.0], [516.0, 1111.0], [126.0, 1111.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [839, 871, 1076, 1077], "block_id": 19, "block_order": null, "group_id": 19, "block_polygon_points": [[839.0, 871.0], [1076.0, 871.0], [1076.0, 1077.0], [839.0, 1077.0]]}, {"block_label": "footer_image", "block_content": "", "block_bbox": [940, 1211, 1122, 1257], "block_id": 20, "block_order": null, "group_id": 20, "block_polygon_points": [[940.0, 1211.0], [1122.0, 1211.0], [1122.0, 1257.0], [940.0, 1257.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.34921514987945557, "coordinate": [119, 89, 193, 129], "order": 1, "polygon_points": [[119.0, 89.0], [193.0, 89.0], [193.0, 129.0], [119.0, 129.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.6560155153274536, "coordinate": [492, 89, 699, 121], "order": 2, "polygon_points": [[492.0, 89.0], [699.0, 89.0], [699.0, 121.0]