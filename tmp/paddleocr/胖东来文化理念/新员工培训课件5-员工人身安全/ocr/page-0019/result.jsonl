366], "block_id": 14, "block_order": 14, "group_id": 14, "block_polygon_points": [[622.0, 323.0], [999.0, 323.0], [999.0, 366.0], [622.0, 366.0]]}, {"block_label": "text", "block_content": "⑥及时通知主管及保安。", "block_bbox": [623, 365, 813, 387], "block_id": 15, "block_order": 15, "group_id": 15, "block_polygon_points": [[623.0, 365.0], [623.0, 386.0], [812.0, 386.0], [812.0, 365.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [622, 401, 912, 616], "block_id": 16, "block_order": null, "group_id": 16, "block_polygon_points": [[622.0, 401.0], [912.0, 401.0], [912.0, 616.0], [622.0, 616.0]]}, {"block_label": "footer_image", "block_content": "", "block_bbox": [939, 595, 1123, 641], "block_id": 17, "block_order": null, "group_id": 17, "block_polygon_points": [[939.0, 595.0], [1123.0, 595.0], [1123.0, 641.0], [939.0, 641.0]]}, {"block_label": "paragraph_title", "block_content": "防盗\n可疑偷窃者的特征", "block_bbox": [136, 825, 324, 888], "block_id": 18, "block_order": 16, "group_id": 18, "block_polygon_points": [[136.0, 825.0], [324.0, 825.0], [324.0, 888.0], [136.0, 888.0]]}, {"block_label": "text", "block_content": "1、手推车中放着敞口手提包的顾客应加以注意。", "block_bbox": [137, 906, 514, 933], "block_id": 19, "block_order": 17, "group_id": 19, "block_polygon_points": [[137.0, 906.0], [514.0, 906.0], [514.0, 933.0], [137.0, 933.0]]}, {"block_label": "text", "block_content": "2、应特别注意把物品放在手推车周围而留下中间以备打包用的顾客。", "block_bbox": [136, 957, 672, 984], "block_id": 20, "block_order": 18, "group_id": 20, "block_polygon_points": [[136.0, 957.0], [672.0, 957.0], [672.0, 984.0], [136.0, 984.0]]}, {"block_label": "text", "block_content": "3、顾客携带“反常”物品时，须多加防备。如：晴天带雨伞等。", "block_bbox": [137, 1007, 637, 1034], "block_id": 21, "block_order": 19, "group_id": 21, "block_polygon_points": [[137.0, 1007.0], [637.0, 1007.0], [637.0, 1034.0], [137.0, 1034.0]]}, {"block_label": "text", "block_content": "4、手拿着货品，在店内四处走动。", "block_bbox": [136, 1058, 409, 1084], "block_id": 22, "block_order": 20, "group_id": 22, "block_polygon_points": [[136.0, 1058.0], [409.0, 1058.0], [409.0, 1084.0], [136.0, 1084.0]]}, {"block_label": "text", "block_content": "5、在短时间内多次进出商场或来到本区域（拿相同商品）的人；", "block_bbox": [137, 1108, 642, 1136], "block_id": 23, "block_order": 21, "group_id": 23, "block_polygon_points": [[137.0, 1108.0], [642.0, 1108.0], [642.0, 1136.0], [137.0, 1136.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [727, 875, 1093, 1083], "block_id": 24, "block_order": null, "group_id": 24, "block_polygon_points": [[727.0, 875.0], [1093.0, 875.0], [1093.0, 1083.0], [727.0, 1083.0]]}, {"block_label": "footer_image", "block_content": "", "block_bbox": [939, 1211, 1122, 1256], "block_id": 25, "block_order": null, "group_id": 25, "block_polygon_points": [[939.0, 1211.0], [1122.0, 1211.0], [1122.0, 1256.0], [939.0, 1256.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.845270037651062, "coordinate": [158, 156, 300, 185], "order": 1, "polygon_points": [[158.0, 156.0], [300.0, 156.0], [300.0, 185.0], [158.0, 185.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.5519264936447144, "coordinate": [159, 193, 219, 217], "order": 2, "polygon_points": [[159.0, 193.0], [218.0, 193.0], [218.0, 216.0], [159.0, 216.0]]}, {"cls_id": 22, "label": "text", "score": 0.8572189807891846, "coordinate": [159, 220, 495, 273], "order": 3, "polygon_points": [[159.0, 220.0], [495.0, 220.0], [495.0, 273.0], [159.0, 273.0]]}, {"cls_id": 22, "label": "text", "score": 0.801814079284668, "coordinate": [158, 275, 422, 301], "order": 4, "polygon_points": [[158.0, 275.0], [422.0, 275.0], [422.0, 301.0], [158.0, 301.0]]}, {"cls_id": 22, "label": "text", "score": 0.8108830451965332, "coordinate": [158, 304, 422, 329], "order": 5, "polygon_points": [[158.0, 304.0], [422.0, 304.0], [422.0, 329.0], [158.0, 329.0]]}, {"cls_id": 22, "label": "text", "score": 0.8246307373046875, "coordinate": [158, 332, 422, 357], "order": 6, "polygon_points": [[158.0, 332.0], [422.0, 332.