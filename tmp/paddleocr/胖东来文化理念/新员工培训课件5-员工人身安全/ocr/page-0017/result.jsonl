0, 1389.0], [687.0, 1389.0]]}, {"cls_id": 22, "label": "text", "score": 0.6768678426742554, "coordinate": [739, 1354, 843, 1388], "order": 19, "polygon_points": [[739.0, 1354.0], [843.0, 1354.0], [843.0, 1388.0], [739.0, 1388.0]]}, {"cls_id": 22, "label": "text", "score": 0.7166685461997986, "coordinate": [737, 1436, 890, 1469], "order": 20, "polygon_points": [[737.0, 1436.0], [890.0, 1436.0], [890.0, 1469.0], [737.0, 1469.0]]}, {"cls_id": 8, "label": "footer", "score": 0.6002919673919678, "coordinate": [94, 1573, 257, 1607], "order": null, "polygon_points": [[94.0, 1573.0], [257.0, 1573.0], [257.0, 1607.0], [94.0, 1607.0]]}]}}, "markdown": {"text": "## 日常生活中如何预防流行性疾病\n\n## 饮食\n\n1. 不食用野生动物（即野味），禽、肉、蛋要充分煮熟后食用；\n\n2. 注意营养、避免偏食、保证摄入食物多样化，尤其是新鲜蔬菜、水果等；\n\n3. 养成良好饮食习惯，按时按量用餐，避免暴饮暴食。\n\n## 运动\n\n1. 积极锻炼，控制体重。此外，适度运动也有助于提高免疫力。\n\n生活方式\n\n1. 戒烟、限酒：\n\n2. 保证充足睡眠、注意休息、避免熬夜；\n\n3. 关注心理健康，注意缓解紧张情绪、减轻心理压力。\n\n## 二、 工作篇\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_90_1083_149_1148.jpg\" alt=\"Image\" width=\"4%\" /></div>\n\n\n## 第二章：工作\n\n永远保持一颗善良的心、走到哪里自己都是一束光\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_431_1226_568_1373.jpg\" alt=\"Image\" width=\"11%\" /></div>\n\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_691_1100_728_1145.jpg\" alt=\"Image\" width=\"3%\" /></div>\n\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_688_1181_731_1223.jpg\" alt=\"Image\" width=\"3%\" /></div>\n\n\n安全\n\n抢劫\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_690_1264_729_1305.jpg\" alt=\"Image\" width=\"3%\" /></div>\n\n\n盗窃\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_687_1351_731_1389.jpg\" alt=\"Image\" width=\"3%\" /></div>\n\n\n人身伤害\n\n卖场突发事件", "images": {"imgs/img_in_footer_image_box_938_593_1123_642.jpg": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//1df17425-8368-4a26-9adf-9ff4f3a74444/markdown_0/imgs/img