.0, 377.0], [230.0, 377.0]]}, {"block_label": "text", "block_content": "1. 积极锻炼，控制体重。此外，适度运动也有助于提高免疫力。", "block_bbox": [229, 388, 825, 417], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[229.0, 388.0], [825.0, 388.0], [825.0, 417.0], [229.0, 417.0]]}, {"block_label": "text", "block_content": "生活方式", "block_bbox": [230, 425, 318, 450], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[230.0, 425.0], [317.0, 425.0], [317.0, 449.0], [230.0, 449.0]]}, {"block_label": "text", "block_content": "1. 戒烟、限酒：", "block_bbox": [231, 460, 382, 487], "block_id": 8, "block_order": 9, "group_id": 8, "block_polygon_points": [[231.0, 460.0], [382.0, 460.0], [382.0, 487.0], [231.0, 487.0]]}, {"block_label": "text", "block_content": "2. 保证充足睡眠、注意休息、避免熬夜；", "block_bbox": [230, 496, 619, 524], "block_id": 9, "block_order": 10, "group_id": 9, "block_polygon_points": [[230.0, 496.0], [619.0, 496.0], [619.0, 524.0], [230.0, 524.0]]}, {"block_label": "text", "block_content": "3. 关注心理健康，注意缓解紧张情绪、减轻心理压力。", "block_bbox": [230, 534, 739, 561], "block_id": 10, "block_order": 11, "group_id": 10, "block_polygon_points": [[230.0, 534.0], [739.0, 534.0], [739.0, 561.0], [230.0, 561.0]]}, {"block_label": "footer_image", "block_content": "", "block_bbox": [938, 593, 1123, 642], "block_id": 11, "block_order": null, "group_id": 11, "block_polygon_points": [[938.0, 593.0], [1123.0, 593.0], [1123.0, 642.0], [938.0, 642.0]]}, {"block_label": "paragraph_title", "block_content": "二、工作篇", "block_bbox": [109, 745, 298, 791], "block_id": 12, "block_order": 12, "group_id": 12, "block_polygon_points": [[109.0, 745.0], [298.0, 745.0], [298.0, 791.0], [109.0, 791.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [90, 1083, 149, 1148], "block_id": 13, "block_order": null, "group_id": 13, "block_polygon_points": [[90.0, 1083.0], [149.0, 1083.0], [149.0, 1148.0], [90.0, 1148.0]]}, {"block_label": "paragraph_title", "block_content": "第二章：工作", "block_bbox