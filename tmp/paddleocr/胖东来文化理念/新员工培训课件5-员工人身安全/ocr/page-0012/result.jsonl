2], "order": 9, "polygon_points": [[167.0, 904.0], [596.0, 904.0], [596.0, 932.0], [167.0, 932.0]]}, {"cls_id": 22, "label": "text", "score": 0.8142369985580444, "coordinate": [166, 950, 322, 977], "order": 10, "polygon_points": [[166.0, 950.0], [322.0, 950.0], [322.0, 977.0], [166.0, 977.0]]}, {"cls_id": 22, "label": "text", "score": 0.8466181755065918, "coordinate": [167, 996, 450, 1023], "order": 11, "polygon_points": [[167.0, 996.0], [450.0, 996.0], [450.0, 1023.0], [167.0, 1023.0]]}, {"cls_id": 22, "label": "text", "score": 0.8938309550285339, "coordinate": [166, 1042, 741, 1104], "order": 12, "polygon_points": [[166.0, 1042.0], [741.0, 1042.0], [741.0, 1104.0], [166.0, 1104.0]]}, {"cls_id": 22, "label": "text", "score": 0.9462873339653015, "coordinate": [166, 1122, 749, 1216], "order": 13, "polygon_points": [[166.0, 1122.0], [749.0, 1122.0], [749.0, 1216.0], [166.0, 1216.0]]}, {"cls_id": 22, "label": "text", "score": 0.9166229963302612, "coordinate": [166, 1235, 742, 1295], "order": 14, "polygon_points": [[166.0, 1235.0], [742.0, 1235.0], [742.0, 1295.0], [166.0, 1295.0]]}, {"cls_id": 14, "label": "image", "score": 0.8899229764938354, "coordinate": [784, 856, 999, 977], "order": null, "polygon_points": [[784.0, 856.0], [999.0, 856.0], [999.0, 977.0], [784.0, 977.0]]}, {"cls_id": 14, "label": "image", "score": 0.9111894965171814, "coordinate": [786, 998, 996, 1126], "order": null, "polygon_points": [[786.0, 998.0], [996.0, 998.0], [996.0, 1126.0], [786.0, 1126.0]]}, {"cls_id": 14, "label": "image", "score": 0.8898131847381592, "coordinate": [786, 1139, 994, 1263], "order": null, "polygon_points": [[786.0, 1139.0], [994.0, 1139.0], [994.0, 1263.0], [786.0, 1263.0]]}, {"cls_id": 9, "label": "footer_image", "score": 0.6131788492202759, "coordinate": [939, 1273, 1123, 1314], "order": null, "polygon_points": [[939.0, 1273.0], [1123.0, 1273.0], [1123.0, 1314.0], [939.0, 1314.0]]}]}}, "markdown": {"text": "## “远离毒品”四大招\n\n1、少去娱乐场所，拒绝陌生人赠送的香烟或饮料。\n\n2、尽量不要结识有不良习惯的人群。\n\n3、对任何形式的毒品要时刻保持警惕，不要抱着猎奇的心态，去尝一尝，试一试，希望从中体验不一样的刺激。\n\n4、不小心沾染上毒品，要立即去戒毒所寻求帮助。\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_689_186_961_365.jpg\" alt=\"Image\" width=\"22%\" /></div>\n\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_690_395_960_559.jpg\" alt=\"Image\" width=\"22%\" /></div>\n\n\n## 生活篇--外出安全\n\n## DL\n\n## 六、 休假期间外出的安全注意事项\n\n1、行前预先规划旅游路线，充分了解交通路况；\n\n2、勤汇报行程：\n\n3、建议现金均分2份分开存放；\n\n4、注意自身旅游安全，勿擅自到未开放的旅游山区和危险山区游玩；注意并依照警告、禁止标志的规定进行旅游；\n\n5、防人之心不可缺少。一些不法分子会利用“老乡”、“同行”等借口主动搭讪，或主动赠送食品及物品，在你放松警惕时实施诈骗和盗窃；\n\n6、爱护自然环境，不破坏景观资源；维护风景区环境整洁，不任意丢弃垃圾。\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_784_856_999_977.jpg\" alt=\"Image\" width=\"18%\" /></div>\n\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_786_998_996_1126.jpg\" alt=\"Image\" width=\"17%\" /></div>\n\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_786_1139_994_1263.jpg\" alt=\"Image\" width=\"17%\" /></div>\n", "images": {"imgs/img_in_image_box_689_186_961_365.jpg": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//0d77ea76-86b4-46ed-ab23-2eb8a396c448/markdown_0/imgs/img_in_image_box_689_186_961_365.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T10%3A53%3A35Z%2F-1%2F%2F2fe32547de620377f586478fea79c61330acd1547e65dfdeaf1563eb17846aac", "imgs/img_in_image_box_690_395_960_559.jpg": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//0d77ea76-86b4-46ed-ab23-2eb8a396c448/markdown_0/imgs/img_in_image_box_690_395_960_559.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T10%3A53%3A36Z%2F-1%2F%2F4d85223c5adedb78631292c40c1c44de1e9b92d0ccad261ded3c4ff8bb56b43c", "imgs/img_in_footer_image_box_939_594_1122_641.jpg": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//0d77ea76-86b4-46ed-ab23-2eb8a396c448/markdown_0/imgs/img_in_footer_image_box_939_5