tImages": {"layout_det_res": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//3cd5fbd6-a18e-4c4f-86b5-44beaeeaae5d/layout_det_res_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A38%3A27Z%2F-1%2F%2F3daf43ff937d6c34747979067ae390338cfbfdb2e0c1786712689653f56326bc"}, "inputImage": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//3cd5fbd6-a18e-4c4f-86b5-44beaeeaae5d/input_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A38%3A28Z%2F-1%2F%2F4d883756c6cda7673845553688b359d36fb18f0142130a2ba4753b0ef77a78f4"}], "dataInfo": {"numPages": 1, "pages": [{"width": 2800, "height": 2000}], "type": "pdf"}, "preprocessedImages": ["https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//3cd5fbd6-a18e-4c4f-86b5-44beaeeaae5d/preprocessed_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A38%3A28Z%2F-1%2F%2F9aa354318e7286917eb607541e8294450b3101d405ad174627536ffa0375755d"]}, "errorCode": 0, "errorMsg": "Success"}
