, 841.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.8687582612037659, "coordinate": [154, 857, 428, 909], "order": 11, "polygon_points": [[154.0, 857.0], [428.0, 857.0], [428.0, 909.0], [154.0, 909.0]]}, {"cls_id": 22, "label": "text", "score": 0.8458955883979797, "coordinate": [238, 926, 1732, 978], "order": 12, "polygon_points": [[238.0, 926.0], [1732.0, 926.0], [1732.0, 978.0], [238.0, 978.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.8602983951568604, "coordinate": [153, 994, 425, 1044], "order": 13, "polygon_points": [[153.0, 994.0], [425.0, 994.0], [425.0, 1044.0], [153.0, 1044.0]]}, {"cls_id": 22, "label": "text", "score": 0.8739027976989746, "coordinate": [237, 1062, 1996, 1114], "order": 14, "polygon_points": [[237.0, 1062.0], [1996.0, 1062.0], [1996.0, 1114.0], [237.0, 1114.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.8610724806785583, "coordinate": [155, 1131, 341, 1181], "order": 15, "polygon_points": [[155.0, 1131.0], [341.0, 1131.0], [341.0, 1181.0], [155.0, 1181.0]]}, {"cls_id": 22, "label": "text", "score": 0.8750649690628052, "coordinate": [239, 1198, 1494, 1251], "order": 16, "polygon_points": [[239.0, 1198.0], [1494.0, 1198.0], [1494.0, 1251.0], [239.0, 1251.0]]}, {"cls_id": 22, "label": "text", "score": 0.883867621421814, "coordinate": [237, 1267, 1453, 1319], "order": 17, "polygon_points": [[237.0, 1267.0], [1453.0, 1267.0], [1453.0, 1319.0], [237.0, 1319.0]]}, {"cls_id": 22, "label": "text", "score": 0.880944013595581, "coordinate": [238, 1336, 1204, 1386], "order": 18, "polygon_points": [[238.0, 1336.0], [1204.0, 1336.0], [1204.0, 1386.0], [238.0, 1386.0]]}, {"cls_id": 22, "label": "text", "score": 0.8835565447807312, "coordinate": [238, 1404, 1183, 1455], "order": 19, "polygon_points": [[238.0, 1404.0], [1183.0, 1404.0], [1183.0, 1455.0], [238.0, 1455.0]]}, {"cls_id": 22, "label": "text", "score": 0.927574098110199, "coordinate": [239, 1471, 2742, 1594], "order": 20, "polygon_points": [[239.0, 1471.0], [2742.0, 1471.0], [2742.0, 1594.0], [239.0, 1594.0]]}, {"cls_id": 16, "label": "number", "score": 0.722751796245575, "coordinate": [63, 1910, 122, 1941], "order": 21, "polygon_points": [[63.0, 1910.0], [122.0, 1910.0], [122.0, 1941.0], [63.0, 1941.0]]}]}}, "markdown": {"text": "（六）在公司连续工龄满七年以上的男、女员工（一胎），从孩子0-3岁，每月享受育儿补助费100元。\n\n（七）处助以上管理人员产假后上岗保留原级别，课长及课长以下管理人员从员工做起。\n\n## 五、 丧事礼金\n\n1. 在公司连续工龄满一三年的员工，父母、岳父母、公婆、配偶、子女去世，由公司送500元以示慰问。\n\n2. 在公司工龄满三年以上送慰问金1000元。\n\n## 六、 医疗福利\n\n### 1. 团体意外伤害\n\n公司为每个员工办理团体意外伤害保险。\n\n### 2. 职工医疗福利\n\n员工生病在公司职工诊所看病，按成本药价收费，免费测血压、体温、脉搏检查、外科检查、免费外伤包扎等健康检查，员工家属可享受同样待遇。\n\n## 七、 员工旅游\n\n公司员工可享受此项福利，福利形式：各部门组织省内游，费用标准：100元/人。\n\n## 八、 困难救助\n\n公司员工如确有困难的，本人可写出书面申请，逐级上报，经公司核实后，根据情况给予救助。\n\n## 九、 其他\n\n1. 公司员工购买电器、服装、生活用品等，可享受优惠价购物待遇。\n\n2. 员工在婚、产、丧期间，如需用车，公司可免费提供车辆帮助。\n\n3. 下级不允许给上级送礼金（结婚、生育、丧事）。\n\n4. 上级给下级送礼金200元（结婚、生育、丧事）。\n\n5. 工伤：员工因工负伤由个人写出书面报告，部门经理审核属实后，确定休养时间并签字后上报公司，公司按照具体情况承担相关费用。非因工负伤、患病或意外伤害，医疗费用保险机构赔偿部分外，其余部分自理，工资参照病假执行。", "images": {}}, "outputImages": {"layout_det_res": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//701854ed-b9b8-4b50-a7ee-6496a2e06870/layout_det_res_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A38%3A48Z%2F-1%2F%2F011ff4c359b12b6386ae0584a0d133ed6f8e8e902792b65e1e7d1bc214435590"}, "inputImage": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//701854ed-b9b8-4b50-a7ee-6496a2e06870/input_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A38%3A48Z%2F-1%2F%2Fc965d633c527d0c2ce7352ccae9a37159d118cad582a7136c28a485fd0eb3a78"}], "dataInfo": {"numPages": 1, "pages": [{"width": 2800, "height": 2000}], "type": "pdf"}, "preprocessedImages": ["https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//701854ed-b9b8-4b50-a7ee-6496a2e06870/preprocessed_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A38%3A48Z%2F-1%2F%2Ffdf2b4995