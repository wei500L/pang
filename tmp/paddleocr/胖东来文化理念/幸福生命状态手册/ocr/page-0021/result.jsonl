ock_id": 5, "block_order": 5, "group_id": 5, "block_polygon_points": [[224.0, 975.0], [325.0, 975.0], [325.0, 1001.0], [224.0, 1001.0]]}, {"block_label": "text", "block_content": "一级【0~1分】：根据收入情况，合理地规划居家，保证轻松、安全、便捷的居家状态。（底线原则）", "block_bbox": [225, 1028, 1051, 1052], "block_id": 6, "block_order": 6, "group_id": 6, "block_polygon_points": [[225.0, 1028.0], [1051.0, 1028.0], [1051.0, 1052.0], [225.0, 1052.0]]}, {"block_label": "text", "block_content": "二级【1~2分】：保证居家基本干净整洁，培养良好的居家生活习惯和居家乐趣。（干净整洁）", "block_bbox": [225, 1062, 998, 1086], "block_id": 7, "block_order": 7, "group_id": 7, "block_polygon_points": [[225.0, 1062.0], [998.0, 1062.0], [998.0, 1086.0], [225.0, 1086.0]]}, {"block_label": "text", "block_content": "三级【2~3分】：居家环境非常干净整洁，且布局合理、温馨舒适，享受品质的居家生活。（品质、温馨）", "block_bbox": [225, 1096, 1064, 1121], "block_id": 8, "block_order": 8, "group_id": 8, "block_polygon_points": [[225.0, 1096.0], [1064.0, 1096.0], [1064.0, 1121.0], [225.0, 1121.0]]}, {"block_label": "text", "block_content": "四级【3~4分】：根据个人经济能力、岗位级别等达到相应的居家品味。（品味）", "block_bbox": [225, 1130, 886, 1155], "block_id": 9, "block_order": 9, "group_id": 9, "block_polygon_points": [[225.0, 1130.0], [886.0, 1130.0], [886.0, 1155.0], [225.0, 1155.0]]}, {"block_label": "text", "block_content": "五级【4~5分】：有先进的居家理念，放松休闲的心灵港湾。（先进理念）", "block_bbox": [226, 1165, 831, 1189], "block_id": 10, "block_order": 10, "group_id": 10, "block_polygon_points": [[226.0, 1165.0], [831.0, 1165.0], [831.0, 1189.0], [226.0, 1189.0]]}, {"block_label": "number", "block_content": "[37]", "block_bbox": [611, 1477, 650, 1498], "block_id": 11, "block_order": null, "group_id": 11, "block_polygon_points": [[611.0, 1477.0], [649.0, 1477.0], [649.0, 1497.0], [611.0, 1497.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.6703898310661316, "coordinate": [165, 140, 456, 172], "order": 1, "polygon_points": [[165.0, 140.0], [456.0, 140.0], [456.0, 172.0], [165.0, 172.0]]}, {"cls_id": 17, "label": "paragraph_title", 