n_points": [[404.0, 409.0], [1392.0, 409.0], [1392.0, 447.0], [404.0, 447.0]]}, {"block_label": "text", "block_content": "（9）不到非正规游泳场所游泳", "block_bbox": [406, 454, 765, 492], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[406.0, 454.0], [765.0, 454.0], [765.0, 492.0], [406.0, 492.0]]}, {"block_label": "text", "block_content": "（10）同业态店助以上同级高管休假外出不同乘一辆车、飞机", "block_bbox": [405, 499, 1120, 537], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[405.0, 499.0], [1120.0, 499.0], [1120.0, 537.0], [405.0, 537.0]]}, {"block_label": "text", "block_content": "3、合理地规划好休假，有良好的休假质量（行程安排轻松合理，不赶时间、不赶行程）", "block_bbox": [388, 544, 1401, 582], "block_id": 8, "block_order": 9, "group_id": 8, "block_polygon_points": [[388.0, 544.0], [1401.0, 544.0], [1401.0, 582.0], [388.0, 582.0]]}, {"block_label": "text", "block_content": "4、购买旅游保险、意外保险（长途旅行购买旅行保险、意外保险，员工保额不低于100万，管理层保额不低于200万）", "block_bbox": [387, 590, 1610, 672], "block_id": 9, "block_order": 10, "group_id": 9, "block_polygon_points": [[387.0, 590.0], [1610.0, 590.0], [1610.0, 672.0], [387.0, 672.0]]}, {"block_label": "number", "block_content": "[87]", "block_bbox": [966, 969, 1021, 997], "block_id": 10, "block_order": null, "group_id": 10, "block_polygon_points": [[966.0, 969.0], [1020.0, 969.0], [1020.0, 996.0], [966.0, 996.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.8955700993537903, "coordinate": [364, 119, 793, 167], "order": 1, "polygon_points": [[364.0, 119.0], [793.0, 119.0], [793.0, 167.0], [364.0, 167.0]]}, {"cls_id": 22, "label": "text", "score": 0.8592696785926819, "coordinate": [404, 229, 1246, 267], "order": 2, "polygon_points": [[404.0, 229.0], [1246.0, 229.0], [1246.0, 267.0], [404.0, 267.0]]}, {"cls_id": 22, "label": "text", "score": 0.8596469759941101, "coordinate": [404, 273, 1264, 312], "order": 3, "polygon_points": [[404.0, 273.0], [1264.0, 273.0], [1264.0, 312.0], [404.0, 312.0]]}, {"cls_id": 22, "label": "text",