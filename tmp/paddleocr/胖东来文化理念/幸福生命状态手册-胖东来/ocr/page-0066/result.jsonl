 [1334.0, 434.0], [405.0, 434.0]]}, {"block_label": "text", "block_content": "7、因为早恋而指责、反对、打击孩子", "block_bbox": [391, 443, 838, 476], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[391.0, 443.0], [838.0, 443.0], [838.0, 476.0], [391.0, 476.0]]}, {"block_label": "text", "block_content": "8、过分追问私人问题、翻看孩子日记、窥探孩子隐私等", "block_bbox": [390, 485, 1047, 519], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[390.0, 485.0], [1047.0, 485.0], [1047.0, 519.0], [390.0, 519.0]]}, {"block_label": "text", "block_content": "9、离异时把孩子当成包袱、累赘，拒绝养孩子", "block_bbox": [389, 528, 943, 561], "block_id": 8, "block_order": 9, "group_id": 8, "block_polygon_points": [[389.0, 528.0], [943.0, 528.0], [943.0, 561.0], [389.0, 561.0]]}, {"block_label": "text", "block_content": "10、离异家庭，给孩子传导对方不好或过错，让孩子厌恶甚至憎恨对方，形成更深的误解和伤害", "block_bbox": [390, 571, 1508, 605], "block_id": 9, "block_order": 10, "group_id": 9, "block_polygon_points": [[390.0, 571.0], [1508.0, 571.0], [1508.0, 605.0], [390.0, 605.0]]}, {"block_label": "text", "block_content": "11、因缺乏对孩子的教育或给予不良教育，造成孩子严重的抑郁、性格缺陷或精神类疾病", "block_bbox": [389, 613, 1432, 647], "block_id": 10, "block_order": 11, "group_id": 10, "block_polygon_points": [[389.0, 613.0], [1432.0, 613.0], [1432.0, 647.0], [389.0, 647.0]]}, {"block_label": "number", "block_content": "[63]", "block_bbox": [968, 969, 1019, 996], "block_id": 11, "block_order": null, "group_id": 11, "block_polygon_points": [[968.0, 969.0], [1018.0, 969.0], [1018.0, 995.0], [968.0, 995.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.9081129431724548, "coordinate": [372, 121, 942, 166], "order": 1, "polygon_points": [[372.0, 121.0], [942.0, 121.0], [942.0, 166.0], [372.0, 166.0]]}, {"cls_id": 22, "label": "text", "score": 0.8309717774391174, "coordinate": [405, 230, 915, 264], "order": 2, "polygon_points": [[405.0, 230.0], [915.0, 230.0], [915.0, 264.0], [405.0, 264.0]]}, {"cls_id": 22, "label": "text", "score": 0