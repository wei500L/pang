block_id": 5, "block_order": 6, "group_id": 5, "block_polygon_points": [[399.0, 604.0], [1451.0, 604.0], [1451.0, 639.0], [399.0, 639.0]]}, {"block_label": "text", "block_content": "五级【4~5分】：活出洒脱、轻松、阳光、自由的生命状态，并影响和带动他人健康的观念和习惯。", "block_bbox": [401, 654, 1584, 689], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[401.0, 654.0], [1584.0, 654.0], [1584.0, 689.0], [401.0, 689.0]]}, {"block_label": "number", "block_content": "[95]", "block_bbox": [968, 970, 1019, 996], "block_id": 7, "block_order": null, "group_id": 7, "block_polygon_points": [[968.0, 970.0], [1018.0, 970.0], [1018.0, 995.0], [968.0, 995.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.868550181388855, "coordinate": [363, 121, 790, 166], "order": 1, "polygon_points": [[363.0, 121.0], [790.0, 121.0], [790.0, 166.0], [363.0, 166.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.815561830997467, "coordinate": [400, 231, 543, 267], "order": 2, "polygon_points": [[400.0, 231.0], [543.0, 231.0], [543.0, 267.0], [400.0, 267.0]]}, {"cls_id": 22, "label": "text", "score": 0.9170759916305542, "coordinate": [398, 307, 1600, 390], "order": 3, "polygon_points": [[398.0, 307.0], [1600.0, 307.0], [1600.0, 390.0], [398.0, 390.0]]}, {"cls_id": 22, "label": "text", "score": 0.9221382737159729, "coordinate": [400, 407, 1599, 489], "order": 4, "polygon_points": [[400.0, 407.0], [1599.0, 407.0], [1599.0, 489.0], [400.0, 489.0]]}, {"cls_id": 22, "label": "text", "score": 0.9177047610282898, "coordinate": [401, 505, 1598, 586], "order": 5, "polygon_points": [[401.0, 505.0], [1598.0, 505.0], [1598.0, 586.0], [401.0, 586.0]]}, {"cls_id": 22, "label": "text", "score": 0.8601157069206238, "coordinate": [399, 604, 1451, 639], "order": 6, "polygon_points": [[399.0, 604.0], [1451.0, 604.0], [1451.0, 639.0], [399.0, 639.0]]}, {"cls_id": 22, "label": "text", "score": 0.8675083518028259, "coordinate": [401, 654, 1584, 689], "order": 7, "polygon_points": [[401.0, 654.0], [1584.0, 654.0], [1584.0, 689.0], [401.0, 689.0]]}, {"cls_id": 16, "label": "number", "score": 0.6429052948951721, "coordinate": [968, 970, 1019, 996], "order": 8, "polygon_points": [[968.0, 970.0], [1018.0, 970.0], [1018.0, 995.0], [968.0, 995.0]]}]}}, "markdown": {"text": "## 考评奖励标准——健康\n\n## 标准等级：\n\n一级【0~1分】：懂得健康的原理，身体与情绪相互之间的影响作用，避免造成严重的痛苦或不可挽回的身心伤害。\n\n二级【1~2分】：保持积极、乐观的心态，有良好的自我调节能力，能够掌控自我情绪，也能够主动地调节身体指标保持相对健康的状态。\n\n三级【2~3分】：比较成熟的心态，善于看到事物好的一面，具备把坏事变好事的能力，不断地进步和提升。\n\n四级【3~4分】：感恩生命中的一切经历和发生，能够从风雨和苦难中品出美好和幸福。\n\n五级【4~5分】：活出洒脱、轻松、阳光、自由的生命状态，并影响和带动他人健康的观念和习惯。", "images": {}}, "outputImages": {"layout_det_res": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//81ed3589-08f7-4e49-a65f-aa747ec9273f/layout_det_res_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T07%3A47%3A23Z%2F-1%2F%2F73d86cf84d4359a2ef63aa7690fce4e9d09aff9679aa56b2d054c0c7affc745f"}, "inputImage": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//81ed3589-08f7-4e49-a65f-aa747ec9273f/input_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T07%3A47%3A23Z%2F-1%2F%2F52d17f6f8e2bb96ca59310c4d64f490ced9b949580c0ec1b78c419ce314b16de"}], "dataInfo": {"numPages": 1, "pages": [{"width": 1920, "height": 1080}], "type": "pdf"}, "preprocessedImages": ["https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//81ed3589-08f7-4e49-a65f-aa747ec9273f/preprocessed_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T07%3A47%3A23Z%2F-1%2F%2F11c5f4a7ea7b4ad595bd7dfb3b3a00e04eafcf76f6052d0dc561f13e99c544e8"]}, "errorCode": 0, "errorMsg": "Success"}
