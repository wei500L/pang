38], "block_id": 5, "block_order": 6, "group_id": 5, "block_polygon_points": [[398.0, 555.0], [1600.0, 555.0], [1600.0, 638.0], [398.0, 638.0]]}, {"block_label": "text", "block_content": "五级【4~5分】：彼此尊重、彼此独立、没有束缚和包袱，各自活好自己阳光的生命。（自由）", "block_bbox": [399, 654, 1532, 689], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[399.0, 654.0], [1532.0, 654.0], [1532.0, 689.0], [399.0, 689.0]]}, {"block_label": "number", "block_content": "[53]", "block_bbox": [967, 970, 1020, 996], "block_id": 7, "block_order": null, "group_id": 7, "block_polygon_points": [[967.0, 970.0], [1019.0, 970.0], [1019.0, 995.0], [967.0, 995.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.8843550086021423, "coordinate": [364, 120, 935, 166], "order": 1, "polygon_points": [[364.0, 120.0], [935.0, 120.0], [935.0, 166.0], [364.0, 166.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.7845927476882935, "coordinate": [400, 231, 543, 267], "order": 2, "polygon_points": [[400.0, 231.0], [543.0, 231.0], [543.0, 267.0], [400.0, 267.0]]}, {"cls_id": 22, "label": "text", "score": 0.8431900143623352, "coordinate": [399, 307, 1259, 342], "order": 3, "polygon_points": [[399.0, 307.0], [1259.0, 307.0], [1259.0, 342.0], [399.0, 342.0]]}, {"cls_id": 22, "label": "text", "score": 0.9243947863578796, "coordinate": [400, 358, 1600, 441], "order": 4, "polygon_points": [[400.0, 358.0], [1600.0, 358.0], [1600.0, 441.0], [400.0, 441.0]]}, {"cls_id": 22, "label": "text", "score": 0.9163702130317688, "coordinate": [401, 456, 1599, 541], "order": 5, "polygon_points": [[401.0, 456.0], [1599.0, 456.0], [1599.0, 541.0], [401.0, 541.0]]}, {"cls_id": 22, "label": "text", "score": 0.9206840395927429, "coordinate": [398, 555, 1600, 638], "order": 6, "polygon_points": [[398.0, 555.0], [1600.0, 555.0], [1600.0, 638.0], [398.0, 638.0]]}, {"cls_id": 22, "label": "text", "score": 0.8592008948326111, "coordinate": [399, 654, 1532, 689], "order": 7, "polygon_points": [[399.0, 654.0], [1532.0, 654.0], [1532.0, 689.0], [399.0, 689.0]]}, {"cls_id": 16, "label": "number", "score": 0.6715495586395264, "coordinate": [967, 970, 1020, 996], "order": 8, "polygon_points": [[967.0, 970.0], [1019.0, 970.0], [1019.0, 995.0], [967.0, 995.0]]}]}}, "markdown": {"text": "## 考评奖励标准——家庭（父母）\n\n## 标准等级：\n\n一级【0~1分】：不因父母问题造成精神包袱和家庭矛盾。（底线原则）\n\n二级【1~2分】：不依附父母，与父母保持良好的沟通、理解和关爱，量力而行地照顾父母生活，整体和睦融洽。（传统）\n\n三级【2~3分】：能够积极理性地寻找有效的方法沟通，彼此达成尊重对方思想观念和生活态度的共识，享受普遍价值观下的亲情状态。（尊重）\n\n四级【3~4分】：基于独立生命个体的觉知和觉醒，超越传统的尊卑长幼和孝顺，与父母平等相处的状态。（平等）\n\n五级【4~5分】：彼此尊重、彼此独立、没有束缚和包袱，各自活好自己阳光的生命。（自由）", "images": {}}, "outputImages": {"layout_det_res": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//97c82153-aed3-4ba8-a2d6-5b71acbf4019/layout_det_res_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T07%3A32%3A21Z%2F-1%2F%2Fa11ca58ade332da54984072cbcb5a49632305e74633d1f37b0a0daa2bdf1aad1"}, "inputImage": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//97c82153-aed3-4ba8-a2d6-5b71acbf4019/input_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T07%3A32%3A22Z%2F-1%2F%2F4f203e846d235cc1dfaeddbb577dc106db880029deeea02f0d1b0241f54c151e"}], "dataInfo": {"numPages": 1, "pages": [{"width": 1920, "height": 1080}], "type": "pdf"}, "preprocessedImages": ["https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//97c82153-aed3-4ba8-a2d6-5b71acbf4019/preprocessed_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T07%3A32%3A22Z%2F-1%2F%2Ff656e3d01070389778646e76c0bcf2b365a97da59885207c1be975ce7df0c8ef"]}, "errorCode": 0, "errorMsg": "Success"}
