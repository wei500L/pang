_order": 6, "group_id": 5, "block_polygon_points": [[388.0, 547.0], [1124.0, 547.0], [1124.0, 578.0], [388.0, 578.0]]}, {"block_label": "text", "block_content": "3、即便是乞丐，也能重新打造轻松、自由、快乐的生活", "block_bbox": [388, 592, 1044, 623], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[388.0, 592.0], [1044.0, 592.0], [1044.0, 623.0], [388.0, 623.0]]}, {"block_label": "text", "block_content": "4、有轻松、自由和先进的理念、思想，即使物质方面一无所有，精神方面依旧富有", "block_bbox": [388, 636, 1357, 669], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[388.0, 636.0], [1357.0, 636.0], [1357.0, 669.0], [388.0, 669.0]]}, {"block_label": "number", "block_content": "[81]", "block_bbox": [968, 970, 1020, 996], "block_id": 8, "block_order": null, "group_id": 8, "block_polygon_points": [[968.0, 970.0], [1019.0, 970.0], [1019.0, 995.0], [968.0, 995.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.9038903713226318, "coordinate": [364, 121, 787, 164], "order": 1, "polygon_points": [[364.0, 121.0], [787.0, 121.0], [787.0, 164.0], [364.0, 164.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.7684686183929443, "coordinate": [363, 232, 1411, 264], "order": 2, "polygon_points": [[363.0, 232.0], [1411.0, 232.0], [1411.0, 264.0], [363.0, 264.0]]}, {"cls_id": 22, "label": "text", "score": 0.934695303440094, "coordinate": [362, 299, 1609, 378], "order": 3, "polygon_points": [[362.0, 299.0], [1609.0, 299.0], [1609.0, 378.0], [362.0, 378.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.8558065295219421, "coordinate": [365, 443, 535, 475], "order": 4, "polygon_points": [[365.0, 443.0], [535.0, 443.0], [535.0, 475.0], [365.0, 475.0]]}, {"cls_id": 22, "label": "text", "score": 0.8674910664558411, "coordinate": [387, 502, 1175, 533], "order": 5, "polygon_points": [[387.0, 502.0], [1175.0, 502.0], [1175.0, 533.0], [387.0, 533.0]]}, {"cls_id": 22, "label": "text", "score": 0.8618698120117188, "coordinate": [388, 547, 1124, 578], "