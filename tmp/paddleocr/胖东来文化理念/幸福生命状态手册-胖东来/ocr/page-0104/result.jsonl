.0, 447.0]]}, {"block_label": "text", "block_content": "5、时常指责他人而不自我反思", "block_bbox": [337, 460, 702, 490], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[337.0, 460.0], [702.0, 460.0], [702.0, 490.0], [337.0, 490.0]]}, {"block_label": "text", "block_content": "6、认为人生不如意十之八九是正常，感觉工作和生活总有很多烦恼和压力", "block_bbox": [338, 502, 1199, 533], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[338.0, 502.0], [1199.0, 502.0], [1199.0, 533.0], [338.0, 533.0]]}, {"block_label": "text", "block_content": "7、总给他人带来负面情绪的影响，或总是需要他人的安慰和劝导", "block_bbox": [338, 546, 1095, 577], "block_id": 8, "block_order": 9, "group_id": 8, "block_polygon_points": [[338.0, 546.0], [1095.0, 546.0], [1095.0, 577.0], [338.0, 577.0]]}, {"block_label": "text", "block_content": "8、让身体持续处于疲惫和劳累状态", "block_bbox": [339, 588, 754, 619], "block_id": 9, "block_order": 10, "group_id": 9, "block_polygon_points": [[339.0, 588.0], [754.0, 588.0], [754.0, 619.0], [339.0, 619.0]]}, {"block_label": "text", "block_content": "9、总是感觉心累", "block_bbox": [338, 632, 544, 663], "block_id": 10, "block_order": 11, "group_id": 10, "block_polygon_points": [[338.0, 632.0], [544.0, 632.0], [544.0, 663.0], [338.0, 663.0]]}, {"block_label": "number", "block_content": "[100]", "block_bbox": [909, 968, 967, 992], "block_id": 11, "block_order": null, "group_id": 11, "block_polygon_points": [[909.0, 968.0], [966.0, 968.0], [966.0, 991.0], [909.0, 991.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.8624565005302429, "coordinate": [312, 121, 735, 164], "order": 1, "polygon_points": [[312.0, 121.0], [735.0, 121.0], [735.0, 164.0], [312.0, 164.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.8013724088668823, "coordinate": [312, 228, 509, 260], "order": 2, "polygon_points": [[312.0, 228.0], [509.0, 228.0], [509.0, 260.0], [312.0, 260.0]]}, {"cls_id": 22, "label": "text", "score": 0.7999663352966309, "coordinate": [338, 286, 938, 318], "order"