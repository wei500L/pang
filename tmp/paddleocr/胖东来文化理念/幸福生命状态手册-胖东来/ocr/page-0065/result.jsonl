polygon_points": [[335.0, 542.0], [989.0, 542.0], [989.0, 573.0], [335.0, 573.0]]}, {"block_label": "text", "block_content": "3、以成绩为导向评价和教育孩子，孩子分数不好时批评、否定、指责", "block_bbox": [335, 584, 1149, 616], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[335.0, 584.0], [1149.0, 584.0], [1149.0, 616.0], [335.0, 616.0]]}, {"block_label": "text", "block_content": "4、父母“自我牺牲”式的付出，让孩子背负沉重的压力、责任、束缚等", "block_bbox": [337, 626, 1176, 658], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[337.0, 626.0], [1176.0, 626.0], [1176.0, 658.0], [337.0, 658.0]]}, {"block_label": "text", "block_content": "（1）经常用“都是为了你好”“要不是为了你”“我辛辛苦苦把你养大”等语言教育孩子", "block_bbox": [352, 668, 1383, 701], "block_id": 8, "block_order": 9, "group_id": 8, "block_polygon_points": [[352.0, 668.0], [1383.0, 668.0], [1383.0, 701.0], [352.0, 701.0]]}, {"block_label": "text", "block_content": "（2）总是强调或凸显父母如何辛苦、如何付出，为了让孩子争气、努力", "block_bbox": [354, 711, 1176, 743], "block_id": 9, "block_order": 10, "group_id": 9, "block_polygon_points": [[354.0, 711.0], [1176.0, 711.0], [1176.0, 743.0], [354.0, 743.0]]}, {"block_label": "text", "block_content": "5、伤害孩子自尊心、自信心的行为", "block_bbox": [337, 754, 754, 785], "block_id": 10, "block_order": 11, "group_id": 10, "block_polygon_points": [[337.0, 754.0], [754.0, 754.0], [754.0, 785.0], [337.0, 785.0]]}, {"block_label": "text", "block_content": "（1）在人前暴露或批评孩子的缺点", "block_bbox": [353, 796, 755, 828], "block_id": 11, "block_order": 12, "group_id": 11, "block_polygon_points": [[353.0, 796.0], [755.0, 796.0], [755.0, 828.0], [353.0, 828.0]]}, {"block_label": "text", "block_content": "(2) 经常拿孩子和他人对比", "block_bbox": [354, 838, 678, 870], "block_id": 12, "block_order": 13, "group_id": 12, "block_polygon_points": [[354.0, 838.0], [678.0, 838.0], [678.0, 870.0], [354.0, 870.0]]}, {"block_label": "number", "block_content": "[62]", "block_bbox": [914, 968, 957, 993], "block_id": 13, "block_order": null, "group_id": 13, "block_polygon_points": [[914.0, 