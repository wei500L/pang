0], [389.0, 851.0]]}, {"cls_id": 22, "label": "text", "score": 0.8341318368911743, "coordinate": [389, 864, 1043, 896], "order": 12, "polygon_points": [[389.0, 864.0], [1043.0, 864.0], [1043.0, 896.0], [389.0, 896.0]]}, {"cls_id": 16, "label": "number", "score": 0.7448251843452454, "coordinate": [970, 971, 1018, 995], "order": 13, "polygon_points": [[970.0, 971.0], [1017.0, 971.0], [1017.0, 994.0], [970.0, 994.0]]}]}}, "markdown": {"text": "## 考评奖励标准——居家\n\n## 五 级【4~5分】：有先进的居家理念，放松休闲的心灵港湾。\n\n- 本条释义：有先进的居家理念，家是属于夫妻两个人的，不应该规划老人同住、也不规划孩子18岁后居住，是真正的放松、休闲、自由的空间和心灵港湾。\n\n## 符合的行为：\n\n1、围绕夫妻二人展开、注重居家的功能与实用，仅安排夫妻、孩子的卧室\n\n2、长久的居家规划是两个卧室，一个是夫妻二人的，一个是客房、用于临时居住（有保姆的家庭，预留保姆房除外）\n\n3、不与老人同住\n\n4、不与子女同住（20岁以后）\n\n5、与自身贴合、实用的餐厅及其他功能配置\n\n6、家是属于自己的地方，喜欢的人出入\n\n7、能让自己安静、轻松、自由，休憩和涵养自己心灵\n\n8、有保姆的家庭，建立亲近良好、彼此满意幸福的状态", "images": {}}, "outputImages": {"layout_det_res": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//46c14719-8f39-4624-901b-cba00149a547/layout_det_res_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T07%3A30%3A01Z%2F-1%2F%2Fae0e5630740b7271c11ac766a6bb86766e92b7f5d53c5bd3db7f01ccd0763bba"}, "inputImage": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//46c14719-8f39-4624-901b-cba00149a547/input_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T07%3A30%3A01Z%2F-1%2F%2Fe2cd495b361a0e57f515e6f5a0b23f480dc781e557a2f57908f805e95c278b24"}], "dataInfo": {"numPages": 1, "pages": [{"width": 1920, "height": 1080}], "type": "pdf"}, "preprocessedImages": ["https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//46c14719-8f39-4624-901b-cba00149a547/preprocessed_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T07%3A30%3A01Z%2F-1%2F%2F57b66b83abeb47eb064b0a6d61adf48d77a1047b6f018b50e2de25c4f943fb4d"]}, "errorCode": 0, "errorMsg": "Success"}
