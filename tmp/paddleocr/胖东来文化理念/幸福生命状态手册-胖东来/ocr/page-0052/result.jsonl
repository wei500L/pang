d": 5, "block_order": 6, "group_id": 5, "block_polygon_points": [[387.0, 549.0], [1604.0, 549.0], [1604.0, 625.0], [387.0, 625.0]]}, {"block_label": "text", "block_content": "3、不与老人同住", "block_bbox": [390, 639, 599, 670], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[390.0, 639.0], [599.0, 639.0], [599.0, 670.0], [390.0, 670.0]]}, {"block_label": "text", "block_content": "4、不与子女同住（20岁以后）", "block_bbox": [390, 684, 741, 715], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[390.0, 684.0], [741.0, 684.0], [741.0, 715.0], [390.0, 715.0]]}, {"block_label": "text", "block_content": "5、与自身贴合、实用的餐厅及其他功能配置", "block_bbox": [389, 730, 911, 760], "block_id": 8, "block_order": 9, "group_id": 8, "block_polygon_points": [[389.0, 730.0], [911.0, 730.0], [911.0, 760.0], [389.0, 760.0]]}, {"block_label": "text", "block_content": "6、家是属于自己的地方，喜欢的人出入", "block_bbox": [390, 774, 859, 806], "block_id": 9, "block_order": 10, "group_id": 9, "block_polygon_points": [[390.0, 774.0], [859.0, 774.0], [859.0, 806.0], [390.0, 806.0]]}, {"block_label": "text", "block_content": "7、能让自己安静、轻松、自由，休憩和涵养自己心灵", "block_bbox": [389, 819, 1018, 851], "block_id": 10, "block_order": 11, "group_id": 10, "block_polygon_points": [[389.0, 819.0], [1018.0, 819.0], [1018.0, 851.0], [389.0, 851.0]]}, {"block_label": "text", "block_content": "8、有保姆的家庭，建立亲近良好、彼此满意幸福的状态", "block_bbox": [389, 864, 1043, 896], "block_id": 11, "block_order": 12, "group_id": 11, "block_polygon_points": [[389.0, 864.0], [1043.0, 864.0], [1043.0, 896.0], [389.0, 896.0]]}, {"block_label": "number", "block_content": "[49]", "block_bbox": [970, 971, 1018, 995], "block_id": 12, "block_order": null, "group_id": 12, "block_polygon_points": [[970.0, 971.0], [1017.0, 971.0], [1017.0, 994.0], [970.0, 994.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.8966203927993774, "coordinate": [372, 121, 795, 164], "order": 1, "polygon_points": [[372.0, 121.0], [795.