{"logId": "c271f699-3a8e-4e9b-89bb-04d788bce7c0", "result": {"layoutParsingResults": [{"prunedResult": {"page_count": null, "width": 1920, "height": 1080, "model_settings": {"use_doc_preprocessor": false, "use_layout_detection": true, "use_chart_recognition": false, "use_seal_recognition": false, "use_ocr_for_image_block": false, "format_block_content": false, "merge_layout_blocks": true, "markdown_ignore_labels": ["number", "footnote", "header", "header_image", "footer", "footer_image", "aside_text"], "return_layout_polygon_points": true}, "parsing_res_list": [{"block_label": "paragraph_title", "block_content": "考评奖励标准——休假", "block_bbox": [311, 120, 736, 165], "block_id": 0, "block_order": 1, "group_id": 0, "block_polygon_points": [[311.0, 120.0], [736.0, 120.0], [736.0, 165.0], [311.0, 165.0]]}, {"block_label": "paragraph_title", "block_content": "- 不符合的行为：", "block_bbox": [311, 228, 510, 260], "block_id": 1, "block_order": 2, "group_id": 1, "block_polygon_points": [[311.0, 228.0], [510.0, 228.0], [510.0, 260.0], [311.0, 260.0]]}, {"block_label": "text", "block_content": "1、休假期间不允许接打电话处理工作事项", "block_bbox": [337, 287, 835, 319], "block_id": 2, "block_order": 3, "group_id": 2, "block_polygon_points": [[337.0, 287.0], [835.0, 287.0], [835.0, 319.0], [337.0, 319.0]]}, {"block_label": "text", "block_content": "（1）不允许主动给休假人员拨打工作电话（除特殊的重大事故）", "block_bbox": [353, 331, 1080, 364], "block_id": 3, "block_order": 4, "group_id": 3, "block_polygon_points": [[353.0, 331.0], [1080.0, 331.0], [1080.0, 364.0], [353.0, 364.0]]}, {"block_label": "text", "block_content": "（2）休假人员不允许打电话处理工作事项（除特殊的重大事故）", "block_bbox": [354, 376, 1079, 408], "block_id": 4, "block_order": 5, "group_id": 4, "block_polygon_points": [[354.0, 376.0], [1079.0, 376.0], [1079.0, 408.0], [354.0, 408.0]]}, {"block_label": "text", "block_content": "2、不信任自己的团队或同事，将工作交由其他部门或其他人代管或监管", "block_bbox": [337, 422, 1173, 453], "block_id": 5, "block_order": 6, "group_id": 5, "block_polygon_points": [[337.0, 422.0], [1173.0, 422.0], [1173.0, 453.0], [337.0, 453.0]]}, {"block_label": "text", "block_content": "3、以“没有钱”“走不开”“家有孩子”等为理由，拒绝享受休假", "block_bbox": [337, 466, 1122, 498], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[337.0, 466.0], [1122.0, 466.0], [1122.0, 498.0], [337.0, 498.0]]}, {"block_label": "text", "block_content": "4、利用休假时间打临时工、做兼职等", "block_bbox": [338, 512, 781, 542], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[338.0, 512.0], [781.0, 512.0], [781.0, 542.0], [338.0, 542.0]]}, {"block_label": "text", "block_content": "5、选择低价格、服务和品质差的旅行团", "block_bbox": [337, 557, 806, 588], "block_id": 8, "block_order": 9, "group_id": 8, "block_polygon_points": [[337.0, 557.0], [806.0, 557.0], [806.0, 588.0], [337.0, 588.0]]}, {"block_label": "text", "block_content": "6、缺乏安全防护意识及自我保护意识，被盗、被骗、被强制消费等", "block_bbox": [337, 602, 1122, 633], "block_id": 9, "block_order": 10, "group_id": 9, "block_polygon_points": [[337.0, 602.0], [1122.0, 602.0], [1122.0, 633.0], [337.0, 633.0]]}, {"block_label": "text", "block_content": "7、盲目跟风、打卡、超出能力范围的过度消费等行为", "block_bbox": [337, 646, 964, 678], "block_id": 10, "block_order": 11, "group_id": 10, "block_polygon_points": [[337.0, 646.0], [964.0, 646.0], [964.0, 678.0], [337.0, 678.0]]}, {"block_label": "text", "block_content": "8、有不文明现象（乱涂乱画、语言粗狂、破坏花草树木、乱扔垃圾等）", "block_bbox": [337, 691, 1156, 723], "block_id": 11, "block_order": 12, "group_id": 11, "block_polygon_points": [[337.0, 691.0], [1156.0, 691.0], [1156.0, 723.0], [337.0, 723.0]]}, {"block_label": "text", "block_content": "9、休闲娱乐必须保证健康、安全，禁止集体组织或涉及黄赌毒等活动", "block_bbox": [336, 736, 1150, 768], "block_id": 12, "block_order": 13, "group_id": 12, "block_polygon_points": [[336.0, 736.0], [1150.0, 736.0], [1150.0, 768.0], [336.0, 768.0]]}, {"block_label": "text", "block_content": "10、休假过程中，与同行伙伴产生争执、不愉快等影响休假品质的行为", "block_bbox": [339, 781, 1162, 813], "block_id": 13, "block_order": 14, "group_id": 13, "block_polygon_points": [[339.0, 781.0], [1162.0, 781.0], [1162.0, 813.0], [339.0, 813.0]]}, {"block_label": "text", "block_content": "11、恶意劝酒、酒后寻衅滋事等，引起纠纷或对自己、他人身心造成伤害等严重后果", "block_bbox": [338, 826, 1319, 859], "block_id": 14, "block_order": 15, "group_id": 14, "block_polygon_points": [[338.0, 826.0], [1319.0, 826.0], [1319.0, 859.0], [338.0, 859.0]]}, {"block_label": "number", "block_content": "[88]", "block_bbox": [916, 968, 955, 992], "block_id": 15, "block_order": null, "group_id": 15, "block_polygon_points": [[916.0, 968.0], [954.0, 968.0], [954.0, 991.0], [916.0, 991.0]]}], "layout_det_res": {"boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.8650794625282288, "coordinate": [311, 120, 736, 165], "order": 1, "polygon_points": [[311.0, 120.0], [736.0, 120.0], [736.0, 165.0], [311.0, 165.0]]}, {"cls_id": 17, "label": "paragraph_title", "score": 0.7670990228652954, "coordinate": [311, 228, 510, 260], "order": 2, "polygon_points": [[311.0, 228.0], [510.0, 228.0], [510.0, 260.0], [311.0, 260.0]]}, {"cls_id": 22, "label": "text", "score": 0.7682986855506897, "coordinate": [337, 287, 835, 319], "order": 3, "polygon_points": [[337.0, 287.0], [835.0, 287.0], [835.0, 319.0], [337.0, 319.0]]}, {"cls_id": 22, "label": "text", "score": 0.7802598476409912, "coordinate": [353, 331, 1080, 364], "order": 4, "polygon_points": [[353.0, 331.0], [1080.0, 331.0], [1080.0, 364.0], [353.0, 364.0]]}, {"cls_id": 22, "label": "text", "score": 0.7962206602096558, "coordinate": [354, 376, 1079, 408], "order": 5, "polygon_points": [[354.0, 376.0], [1079.0, 376.0], [1079.0, 408.0], [354.0, 408.0]]}, {"cls_id": 22, "label": "text", "score": 0.8224658370018005, "coordinate": [337, 422, 1173, 453], "order": 6, "polygon_points": [[337.0, 422.0], [1173.0, 422.0], [1173.0, 453.0], [337.0, 453.0]]}, {"cls_id": 22, "label": "text", "score": 0.799289345741272, "coordinate": [337, 466, 1122, 498], "order": 7, "polygon_points": [[337.0, 466.0], [1122.0, 466.0], [1122.0, 498.0], [337.0, 498.0]]}, {"cls_id": 22, "label": "text", "sc