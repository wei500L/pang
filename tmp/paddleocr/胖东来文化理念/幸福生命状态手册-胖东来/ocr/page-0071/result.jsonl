d": 5, "block_polygon_points": [[351.0, 456.0], [967.0, 456.0], [967.0, 494.0], [351.0, 494.0]]}, {"block_label": "text", "block_content": "（3）教孩子与各种成年人自由、平等交往", "block_bbox": [351, 502, 839, 540], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[351.0, 502.0], [839.0, 502.0], [839.0, 540.0], [351.0, 540.0]]}, {"block_label": "text", "block_content": "（4）陪孩子一起做他喜欢的事情或活动", "block_bbox": [352, 547, 814, 585], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[352.0, 547.0], [814.0, 547.0], [814.0, 585.0], [352.0, 585.0]]}, {"block_label": "text", "block_content": "（5）带孩子去他喜欢的地方参观", "block_bbox": [352, 593, 737, 631], "block_id": 8, "block_order": 9, "group_id": 8, "block_polygon_points": [[352.0, 593.0], [737.0, 593.0], [737.0, 631.0], [352.0, 631.0]]}, {"block_label": "text", "block_content": "（6）允许孩子参与家庭事务的计划或决定", "block_bbox": [352, 639, 837, 676], "block_id": 9, "block_order": 10, "group_id": 9, "block_polygon_points": [[352.0, 639.0], [837.0, 639.0], [837.0, 676.0], [352.0, 676.0]]}, {"block_label": "text", "block_content": "（7）尊重和保护孩子的隐私和权利，给孩子独立的精神成长空间（如进孩子屋要敲门等）", "block_bbox": [349, 684, 1370, 723], "block_id": 10, "block_order": 11, "group_id": 10, "block_polygon_points": [[349.0, 684.0], [1370.0, 684.0], [1370.0, 723.0], [349.0, 723.0]]}, {"block_label": "text", "block_content": "（8）会主动地给孩子道歉", "block_bbox": [352, 731, 656, 767], "block_id": 11, "block_order": 12, "group_id": 11, "block_polygon_points": [[352.0, 731.0], [656.0, 731.0], [656.0, 767.0], [352.0, 767.0]]}, {"block_label": "text", "block_content": "（9）能够与孩子保持真诚、直接、没有任何保留的沟通", "block_bbox": [350, 775, 995, 814], "block_id": 12, "block_order": 13, "group_id": 12, "block_polygon_points": [[350.0, 775.0], [995.0, 775.0], [995.0, 814.0], [350.0, 814.0]]}, {"block_label": "text", "block_content": "4、引导孩子懂得先进的生活理念，塑造正确的人生观、世界观和价值观", "block_bbox": [333, 821, 1180, 860], "block_id": 13, "block_order": 14, "group_id": 13, "block_polygon_points": [[333.0, 821