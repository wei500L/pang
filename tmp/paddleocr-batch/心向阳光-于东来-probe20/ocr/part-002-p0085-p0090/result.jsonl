0, 620.0]]}, {"block_label": "text", "block_content": "7月2日 07:56", "block_bbox": [792, 629, 911, 657], "block_id": 2, "block_order": 3, "group_id": 2, "block_polygon_points": [[792.0, 629.0], [911.0, 629.0], [911.0, 657.0], [792.0, 657.0]]}, {"block_label": "text", "block_content": "不失去本性，不迷失自我，找到准确的位置，放大优点，让生命更加奔放！", "block_bbox": [478, 708, 949, 780], "block_id": 3, "block_order": 4, "group_id": 3, "block_polygon_points": [[478.0, 708.0], [949.0, 708.0], [949.0, 780.0], [478.0, 780.0]]}, {"block_label": "text", "block_content": "7月1日 08:52", "block_bbox": [792, 790, 910, 818], "block_id": 4, "block_order": 5, "group_id": 4, "block_polygon_points": [[792.0, 790.0], [910.0, 790.0], [910.0, 818.0], [792.0, 818.0]]}, {"block_label": "text", "block_content": "我们只是宇宙中一颗微小的尘埃，我们的生命在宇宙的长河中只是一瞬间，我们要智慧得懂得怎样活，怎样计划生命的过程…生命的时间是有限的，生命的质量是无限的！", "block_bbox": [477, 869, 949, 1022], "block_id": 5, "block_order": 6, "group_id": 5, "block_polygon_points": [[477.0, 869.0], [949.0, 869.0], [949.0, 1022.0], [477.0, 1022.0]]}, {"block_label": "text", "block_content": "7月1日 00:27", "block_bbox": [792, 1031, 910, 1059], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[792.0, 1031.0], [910.0, 1031.0], [910.0, 1059.0], [792.0, 1059.0]]}, {"block_label": "text", "block_content": "让生命轰轰烈烈的为大爱而活，为自己而活！让生命淡然的感受暴风雨般的考验！所有的过程都是山花烂漫的序幕！", "block_bbox": [477, 1110, 950, 1223], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[477.0, 1110.0], [950.0, 1110.0], [950.0, 1223.0], [477.0, 1223.0]]}, {"block_label": "text", "block_content": "7月1日 00:16", "block_bbox": [792, 1233, 911, 1259], "block_id": 8, "block_order": 9, "group_id": 8, "block_polygon_points": [[792.0, 1233.0], [911.0, 1233.0], [911.0, 1259.0], [792.0, 1259.0]]}, {"block_label": "aside_text", "block_content": "我的微博", "block_bbox": [1015, 596, 1047, 734], "block_id": 9, "block_order": null, "group_id": 9, "block_polygon_points": [[1015.0, 596.0], [1047.0, 596.0], [1047.0, 734.0], [1015.0, 734.0]]}, {"block_label": "number", "block_content": "83", "block_bbox": [1015, 1351, 1044, 1374], "block_id": 10, "block_order": null, "group_id": 10, "block_polygon_points": [[1015.0, 1351.0], [1043.0, 1351.0], [1043.0, 1373.0], [1015.0, 1373.0]]}], "layout_det_res": {"boxes": [{"cls_id": 22, "label": "text", "score": 0.5877726078033447, "coordinate": [478, 225, 950, 336], "order": 1, "polygon_points": [[478.0, 225.0], [950.0, 225.0], [950.0, 336.0], [478.0, 336.0]]}, {"cls_id": 22, "label": "text", "score": 0.5429482460021973, "coordinate": [792, 307, 909, 335], "order": 2, "polygon_points": [[792.0, 307.0], [909.0, 307.0], [909.0, 335.0], [792.0, 335.0]]}, {"cls_id": 22, "label": "text", "score": 0.930606484413147, "coordinate": [477, 388, 950, 620], "order": 3, "polygon_points": [[477.0, 388.0], [950.0, 388.0], [950.0, 620.0], [477.0, 620.0]]}, {"cls_id": 22, "label": "text", "score": 0.7155613303184509, "coordinate": [792, 629, 911, 657], "order": 4, "polygon_points": [[792.0, 629.0], [911.0, 629.0], [911.0, 657.0], [792.0, 657.0]]}, {"cls_id": 22, "label": "text", "score": 0.863207221031189, "coordinate": [478, 708, 949, 780], "order": 5, "polygon_points": [[478.0, 708.0], [949.0, 708.0], [949.0, 780.0], [478.0, 780.0]]}, {"cls_id": 22, "label": "text", "score": 0.7047967314720154, "coordinate": [792, 790, 910, 818], "order": 6, "polygon_points": [[792.0, 790.0], [910.0, 790.0], [910.0, 818.0], [792.0, 818.0]]}, {"cls_id": 22, "label": "text", "score": 0.9195630550384521, "coordinate": [477, 869, 949, 1022], "order": 7, "polygon_points": [[477.0, 869.0], [949.0, 869.0], [949.0, 1022.0], [477.0, 1022.0]]}, {"cls_id": 22, "label": "text", "score": 0.7099220752716064, "coordinate": [792, 1031, 910, 1059], "order": 8, "polygon_points": [[792.0, 1031.0], [910.0, 1031.0], [910.0, 1059.0], [792.0, 1059.0]]}, {"cls_id": 22, "label": "text", "score": 0.9147571921348572, "coordinate": [477, 1110, 950, 1223], "order": 9, "polygon_points": [[477.0, 1110.0], [950.0, 1110.0], [950.0, 1223.0], [477.0, 1223.0]]}, {"cls_id": 22, "label": "text", "score": 0.7602729201316833, "coordinate": [792, 1233, 911, 1259], "order": 10, "polygon_points": [[792.0, 1233.0], [911.0, 1233.0], [911.0, 1259.0], [792.0, 1259.0]]}, {"cls_id": 2, "label": "aside_text", "score": 0.5275061726570129, "coordinate": [1015, 596, 1047, 734], "order": null, "polygon_points": [[1015.0, 596.0], [1047.0, 596.0], [1047.0, 734.0], [1015.0, 734.0]]}, {"cls_id": 16, "label": "number", "score": 0.715169370174408, "coordinate": [1015, 1351, 1044, 1374], "order": 11, "polygon_points": [[1015.0, 1351.0], [1043.0, 1351.0], [1043.0, 1373.0], [1015.0, 1373.0]]}]}}, "markdown": {"text": "智慧的人！会尊重自己的心灵，让心灵少一些无奈的痛苦，多一些知足感恩的快乐！\n\n7月2日 12:01\n\n过分的嫉妒让多少人痛苦，我们一起努力吧，改变自己劣根性的，伤害自己心灵的，丑陋的过度嫉妒心理！让自己因他人的成就而快乐，因他人的成就而找到学习的榜样和激励自己的动力，为他人的幸福而赞美！做一个智慧的，乐观的，心灵高贵的，幸福的人！\n\n7月2日 07:56\n\n不失去本性，不迷失自我，找到准确的位置，放大优点，让生命更加奔放！\n\n7月1日 08:52\n\n我们只是宇宙中一颗微小的尘埃，我们的生命在宇宙的长河中只是一瞬间，我们要智慧得懂得怎样活，怎样计划生命的过程…生命的时间是有限的，生命的质量是无限的！\n\n7月1日 00:27\n\n让生命轰轰烈烈的为大爱而活，为自己而活！让生命淡然的感受暴风雨般的考验！所有的过程都是山花烂漫的序幕！\n\n7月1日 00:16", "images": {}}, "outputImages": {"layout_det_res": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//1d4c8392-b527-4d19-9034-7a327657d0ff/layout_det_res_1.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A54%3A42Z%2F-1%2F%2F8e6a6c79dcfcb6b4dfae1cb913d6d370fad7d1c3b3eab84275b2614b0b5cbcc7"}, "inputImage": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//1d4c8392-b527-4d19-9034-7a327657d0ff/input_img_1.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A54%3A42Z%2F-1%2F%2F35c8d0f36e0663a08b238a9781f5478f2c696e72ca4f5911186697d99a7ac371"}, {"prunedResult": {"page_count": null, "width": 1190, "height": 1684, "model_settings": {"use_doc_preprocessor": false, "use_layout_detection": true, "use_chart_recognition": false, "use_seal_recognition": false, "use_ocr_for_image_block": false, "format_block_content": false, "merge_layout_blocks": true, "markdown_ignore_labels": ["number", "footnote", "header", "header_image", "footer", "footer_image", "aside_text"], "return_layout_polygon_points": true}, "parsing_res_list": [{"block_label": "aside_text", "block_content": "2024年国庆节\nHEART TOWARD THE SUNSHINE", "block_bbox": [153, 539, 204, 763], "block_id": 0, "block_order": null, "group_id": 0, "block_polygon_points": [[153.0, 539.0], [204.0, 539.0], [204.0, 763.0], [153.0, 763.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [289, 235, 663, 739], "block_id": 1, "block_order": null, "group_id": 1, "block_polygon_points": [[289.0, 235.0], [663.0, 235.0], [663.0, 739.0], [289.0, 739.0]]}, {"block_label": "text", "block_content": "对于工作事业…不热爱所做的事根本不会感受到快乐，必须从功利思想的旋涡中跳出来，否则我们只有靠外力带动自己，这样不会幸福更不会长久，只有内心的热爱和激情，才会让自己感受成长的欢乐。才会让自己笑得更灿烂恒久！我们要的是快乐，不是无止境的对物质的贪婪！物质只是证明我们品德和能力的标尺！", "block_bbox": [268, 771, 736, 1073], "block_id": 2, "block_order": 1, "group_id": 2, "block_polygon_points": [[268.0, 771.0], [736.0, 771.0], [736.0, 1073.0], [268.0, 1073.0]]}, {"block_label": "text", "block_content": "6月24日14:10", "block_bbox": [571, 1083, 695, 1107], "block_id": 3, "block_order": 2, "group_id": 3, "block_polygon_points": [[571.0, 1083.0], [695.0, 1083.0], [695.0, 1107.0], [571.0, 1107.0]]}, {"block_label": "text", "block_content": "管理层必须有一定的时间走入员工的岗位\n\n感受工作，体会员工和顾客的感受，给员工更好的指导，让员工习惯按岗位标准工作，引导", "block_bbox": [269, 1161, 737, 1269], "block_id": 4, "block_order": 3, "group_id": 4, "block_polygon_points": [[269.0, 1161.0], [737.0, 1161.0], [737.0, 1269.0], [269.0, 1269.0]]}, {"block_label": "number", "block_content": "84", "block_bbox": [176, 1314, 204, 1336], "block_id": 5, "block_order": null, "group_id": 5, "block_polygon_points": [[176.0, 1314.0], [203.0, 1314.0], [203.0, 1335.0], [176.0, 1335.0]]}], "layout_det_res": {"boxes": [{"cls_id": 2, "label": "aside_text", "score": 0.5389551520347595, "coordinate": [153, 539, 204, 763], "order": null, "polygon_points": [[153.0, 539.0], [204.0, 539.0], [204.0, 763.0], [153.0, 763.0]]}, {"cls_id": 14, "label": "image", "score": 0.963706374168396, "coordinate": [289, 235, 663, 739], "order": null, "polygon_points": [[289.0, 235.0], [663.0, 235.0], [663.0, 739.0], [289.0, 739.0]]}, {"cls_id": 22, "label": "text", "score": 0.9435385465621948, "coordinate": [268, 771, 736, 1073], "order": 1, "polygon_points": [[268.0, 771.0], [736.0, 771.0], [736.0, 1073.0], [268.0, 1073.0]]}, {"cls_id": 22, "label": "text", "score": 0.7387771010398865, "coordinate": [571, 1083, 695, 1107], "order": 2, "polygon_points": [[571.0, 1083.0], [695.0, 1083.0], [695.0, 1107.0], [571.0, 1107.0]]}, {"cls_id": 22, "label": "text", "score": 0.9351204037666321, "coordinate": [269, 1161, 737, 1269], "order": 3, "polygon_points": [[269.0, 1161.0], [737.0, 1161.0], [737.0, 1269.0], [269.0, 1269.0]]}, {"cls_id": 16, "label": "number", "score": 0.7239915728569031, "coordinate": [176, 1314, 204, 1336], "order": 4, "polygon_points": [[176.0, 1314.0], [203.0, 1314.0], [203.0, 1335.0], [176.0, 1335.0]]}]}}, "markdown": {"text": "<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_289_235_663_739.jpg\" alt=\"Image\" width=\"31%\" /></div>\n\n\n对于工作事业…不热爱所做的事根本不会感受到快乐，必须从功利思想的旋涡中跳出来，否则我们只有靠外力带动自己，这样不会幸福更不会长久，只有内心的热爱和激情，才会让自己感受成长的欢乐。才会让自己笑得更灿烂恒久！我们要的是快乐，不是无止境的对物质的贪婪！物质只是证明我们品德和能力的标尺！\n\n6月24日14:10\n\n管理层必须有一定的时间走入员工的岗位\n\n感受工作，体会员工和顾客的感受，给员工更好的指导，让员工习惯按岗位标准工作，引导", "images": {"imgs/img_in_image_box_289_235_663_739.jpg": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//1d4c8392-b527-4d19-9034-7a327657d0ff/markdown_2/imgs/img_in_image_box_289_235_663_739.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A54%3A42Z%2F-1%2F%2F1b614195cbebca802be2b65ff72aa76523bfd68dc929de39bef7fa4d0e3456bb"}}, "outputImages": {"layout_det_res": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//1d4c8392-b527-4d19-9034-7a327657d0ff/layout_det_res_2.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A54%3A43Z%2F-1%2F%2Fc74dfc27bc2d83da207ea895604226a4a2975f4758ff5d4491d419a3269cdb25"}, "inputImage": "https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//1d4c8392-b527-4d19-9034-7a327657d0ff/input_img_2.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-09T09%3A54%3A43Z%2F-1%2F%2Fa0fc28c46d1576411af93166509c456a96223bc5d80c6b740430adedcb42f121"}, {"prunedResult": {"page_count": null, "width": 1190, "height": 1684, "model_settings": {"use_doc_preprocessor": false, "use_layout_detection": true, "use_chart_recognition": false, "use_seal_recognition": false, "use_ocr_for_image_block": false, "format_block_content": false, "merge_layout_blocks": true, "markdown_ignore_labels": ["number", "footnote", "header", "header_image", "footer", "footer_image", "aside_text"], "return_layout_polygon_points": true}, "parsing_res_list": [{"block_label": "text", "block_content": "员工热爱自己的工作，提升专业能力和效率，认真服务好顾客，实现在上班时内心和行为都因工作而快乐！只有从思想明白投入爱就会快乐，然后形成习惯，我们才能真的快乐起来！", "block_bbox": [478, 226, 950, 380], "block_id": 0, "block_order": 1, "group_id": 0, "block_polygon_points": [[478.0, 226.0], [950.0, 226.0], [950.0, 380.0], [478.0, 380.0]]}, {"block_label": "text", "block_content": "6月24日13:57", "block_bbox": [783, 388, 909, 415], "block_id": 1, "block_order": 2, "group_id": 1, "block_polygon_points": [[783.0, 388.0], [909.0, 388.0], [909.0, 415.0], [783.0, 415.0]]}, {"block_label": "text", "block_content": "我们的文化造就我们每个人因过度的嫉妒而痛苦和纠结，见到他人比自己好就受不了。我们一定努力让嫉妒转化成对他人的祝福和对自己的激励和进步的动力，这样我们才能找到真正的快乐！", "block_bbox": [478, 467, 950, 659], "block_id": 2, "block_order": 3, "group_id": 2, "block_polygon_points": [[478.0, 467.0], [950.0, 467.0], [950.0, 659.0], [478.0, 659.0]]}, {"block_label": "text", "block_content": "6月23日07:52", "block_bbox": [784, 669, 909, 696], "block_id": 3, "block_order": 4, "group_id": 3, "block_polygon_points": [[784.0, 669.0], [909.0, 669.0], [909.0, 696.0], [784.0, 696.0]]}, {"block_label": "text", "block_content": "榜样的力量是无穷的！我们要大力赞美，颂扬，学习那些懂得生活，懂得根据自身的条件让生活过得快乐，充实，简单幸福的榜样！希望我们每个人都成为会工作，会生活的榜样！6月23日07:37", "block_bbox": [477, 750, 947, 935], "block_id": 4, "block_order": 5, "group_id": 4, "block_polygon_points": [[477.0, 750.0], [947.0, 750.0], [947.0, 935.0], [477.0, 935.0]]}, {"block_label": "text", "block_content": "记得八十年代，我二十岁时，我住的房间虽然不大，三十多平方，有卧室，客厅，厨房。我喜欢温馨，干净和整洁，就自己动手，粉地板，刷墙，贴壁纸，做窗帘…等等，当时虽然我没那么多钱，靠自己的劳动和热情，我把自己的家打扮的非常时尚。大家要善于劳动和创造，让生活充满幸福，浪漫和唯美的色彩！", "block_bbox": [477, 991, 950, 1263], "block_id": 5, "block_order": 6, "group_id": 5, "block_polygon_points": [[477.0, 991.0], [950.0, 991.0], [950.0, 1263.0], [477.0, 1263.0]]}, {"block_label": "text", "block_content": "6月23日07:10", "block_bbox": [784, 1273, 911, 1299], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[784.0, 1273.0], [911.0, 1273.0], [911.0, 1299.0], [784.0, 1299.0]]}, {"block_label": "vertical_text", "block_content": "我的微博", "block_bbox": [1016, 597, 1046, 733], "block_id": 7, "block_order": 8, "group_id": 7, "block_polygon_points": [[1016.0, 597.0], [1046.0, 597.0], [1046.0, 733.0], [1016.0, 733.0]]}, {"block_label": "number", "block_content": "85", "block_bbox": [1015, 1350, 1044, 1374], "block_id": 8, "block_order": null, "group_id": 8, "block_polygon_points": [[1015.0, 1350.0], [1043.0, 1350.0], [1043.0, 1373.0], [1015.0, 1373.0]]}], "layout_det_res": {"boxes": [{"cls_id": 22, "label": "text", "score": 0.9086142182350159, "coordinate": [478, 226, 950, 380], "order": 1, "polygon_points": [[478.0, 226.0], [950.0, 226.0], [950.0, 380.0], [478.0, 380.0]]}, {"cls_id": 22, "label": "text", "score": 0.7016780376434326, "coordinate": [783, 388, 909, 415], "order": 2, "polygon_points": [[783.0, 388.0], [909.0, 388.0], [909.0, 415.0], [783.0, 415.0]]}, {"cls_id": 22, "label": "text", "score": 0.9333963990211487, "coordinate": [478, 467, 950, 659], "order": 3, "polygon_points": [[478.0, 467.0], [950.0, 467.0], [950.0, 659.0], [478.0, 659.0]]}, {"cls_id": 22, "label": "text", "score": 0.6635809540748596, "coordinate": [784, 669, 909, 696], "order": 4, "polygon_points": [[784.0, 669.0], [909.0, 669.0], [909.0, 696.0], [784.0, 696.0]]}, {"cls_id": 22, "label": "text", "score": 0.8509497046470642, "coordinate": [477, 750, 947, 935], "order": 5, "polygon_points": [[477.0, 750.0], [947.0, 750.0], [947.0, 935.0], [477.0, 935.0]]}, {"cls_id": 22, "label": "text", "score": 0.5607002973556519, "coordinate": [784, 912, 910, 937], "order": 6, "polygon_points": [[784.0, 912.0], [910.0, 912.0], [910.0, 937.0], [784.0, 937.0]]}, {"cls_id": 22, "label": "text", "score": 0.9471878409385681, "coordinate": [477, 991, 950, 1263], "order": 7, "polygon_points": [[477.0, 991.0], [950.0, 991.0], [950.0, 1263.0], [477.0, 1263.0]]}, {"cls_id": 22, "label": "text", "score": 0.7661463618278503, "coordinate": [784, 1273, 911, 1299], "order": 8, "polygon_points": [[784.0, 1273.0], [911.0, 1273.0], [911.0, 1299.0], [784.0, 1299.0]]}, {"cls_id": 23, "label": "vertical_text", "score": 0.47164711356163025, "coordinate": [1016, 597, 1046, 733], "order": 9, "polygon_points": [[1016.0, 597.0], [1046.0, 597.0], [1046.0, 733.0], [1016.0, 733.0]]}, {"cls_id": 16, "label": "number", "score": 0.7254946827888489, "coordinate": [1015, 1350, 1044, 1374], "order": 10, "polygon_points": [[1015.0, 1350.0], [1043.0, 1350.0], [1043.0, 1373.0], [1015.0, 1373.0]]}]}}, "markdown": {"text": "员工热爱自己的工作，提升专业能力和效率，认真服务好顾客，实现在上班时内心和行为都因工作而快乐！只有从思想明白投入爱就会快乐，然后形成习惯，我们才能真的快乐起来！\n\n6月24日13:57\n\n我们的文化造就我们每个人因过度的嫉妒而痛苦和纠结，见到他人比自己好就受不了。我们一定努力让嫉妒转化成对他人的祝福和对自己的激励和进步的动力，这样我们才能找到真正的快乐！\n\n6月23日07:52\n\n榜样的力量是无穷的！我们要大力赞美，颂扬，学习那些懂得生活，懂得根据自身的条件让生活过得快乐，充实，简单幸福的榜样！希望我们每个人都成为会工作，会生活的榜样！6月23日07:37\n\n记得八十年代，我二十岁时，我住的房间虽然不大，三十多平方，有卧室，客厅，厨房。我喜欢温馨，干净和整洁，就自己动手，粉地板，刷墙，贴壁纸，做窗帘…等等，当时虽然我没那么多钱，靠自己的劳动和热情，我把自己的家打扮的非常时尚。大家要善于劳动和创造，让生活充满幸福，浪漫和唯美的色彩！\n\n6月23日07:10\n\n我的微博", "images": {}}, "outputImages": {"layout_det_res": "https://pplines-online.bj.bcebos.com/de