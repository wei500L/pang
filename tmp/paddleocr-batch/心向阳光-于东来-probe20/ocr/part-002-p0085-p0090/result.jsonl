k_order": 5, "group_id": 5, "block_polygon_points": [[268.0, 573.0], [738.0, 573.0], [738.0, 760.0], [268.0, 760.0]]}, {"block_label": "text", "block_content": "6月21日11:30", "block_bbox": [570, 770, 697, 794], "block_id": 6, "block_order": 6, "group_id": 6, "block_polygon_points": [[570.0, 770.0], [697.0, 770.0], [697.0, 794.0], [570.0, 794.0]]}, {"block_label": "text", "block_content": "我们夫妻俩一个心脏手术，一个癌症手术，我们依然与阳光同行！值得朋友们分享我们生活态度！多感受阳光，多发现阳光，多分享阳光…让生命多一些阳光的沐浴！", "block_bbox": [267, 847, 736, 995], "block_id": 7, "block_order": 7, "group_id": 7, "block_polygon_points": [[267.0, 847.0], [736.0, 847.0], [736.0, 995.0], [267.0, 995.0]]}, {"block_label": "text", "block_content": "6月21日11:11", "block_bbox": [569, 1004, 696, 1028], "block_id": 8, "block_order": 8, "group_id": 8, "block_polygon_points": [[569.0, 1004.0], [696.0, 1004.0], [696.0, 1028.0], [569.0, 1028.0]]}, {"block_label": "text", "block_content": "我会不断传导自己的生活态度和方式，我要让自己阳光，自由，淡定，播爱…", "block_bbox": [269, 1081, 736, 1149], "block_id": 9, "block_order": 9, "group_id": 9, "block_polygon_points": [[269.0, 1081.0], [736.0, 1081.0], [736.0, 1149.0], [269.0, 1149.0]]}, {"block_label": "text", "block_content": "6月21日10:33", "block_bbox": [568, 1160, 697, 1185], "block_id": 10, "block_order": 10, "group_id": 10, "block_polygon_points": [[568.0, 1160.0], [697.0, 1160.0], [697.0, 1185.0], [568.0, 1185.0]]}, {"block_label": "text", "block_content": "我没有真正的宗教信仰，我暂时就信善良。", "block_bbox": [313, 1237, 733, 1266], "block_id": 11, "block_order": 11, "group_id": 11, "block_polygon_points": [[313.0, 1237.0], [733.0, 1237.0], [733.0, 1266.0], [313.0, 1266.0]]}, {"block_label": "number", "block_content": "86", "block_bbox": [175, 1314, 205, 1337], "block_id": 12, "block_order": null, "group_id": 12, "block_polygon_points": [[175.0, 1314.0], [204.0, 1314.0], [204.0, 1336.0], [175.0, 1336.0]]}], "layout_det_res": {"boxes": [{"cls_id": 2, "label": "aside_text", "score": 0.651214599609375, "coordinate": [152, 537, 205, 761], "order": 