ing_res_list": [{"block_label": "image", "block_content": "", "block_bbox": [504, 222, 907, 796], "block_id": 0, "block_order": null, "group_id": 0, "block_polygon_points": [[504.0, 222.0], [907.0, 222.0], [907.0, 796.0], [504.0, 796.0]]}, {"block_label": "text", "block_content": "粳策自己在不利用他人，不伤害他人，不违背善良的基础上，勇敢自信的做自己喜欢的事！自己越来越自信，乐观，果敢，自由和阳光…6月19日22：43", "block_bbox": [483, 834, 933, 980], "block_id": 1, "block_order": 1, "group_id": 1, "block_polygon_points": [[483.0, 834.0], [933.0, 834.0], [933.0, 980.0], [483.0, 980.0]]}, {"block_label": "text", "block_content": "在没有信仰的环境中，成功的概念只在功利的范畴，那么我们付出沉重的生理健康和精神劳累追求的成功到底是为了什么？喜欢吗？热爱吗？开心吗？累吗？能让自己和当下的人们幸福吗？自己真的需要吗？……醒醒吧！让自己早一天明白并实现做自己喜欢和热爱的事", "block_bbox": [483, 1030, 937, 1254], "block_id": 2, "block_order": 2, "group_id": 2, "block_polygon_points": [[483.0, 1030.0], [937.0, 1030.0], [937.0, 1254.0], [483.0, 1254.0]]}, {"block_label": "vertical_text", "block_content": "我的微博", "block_bbox": [999, 574, 1028, 706], "block_id": 3, "block_order": 3, "group_id": 3, "block_polygon_points": [[999.0, 574.0], [1028.0, 574.0], [1028.0, 706.0], [999.0, 706.0]]}, {"block_label": "number", "block_content": "87", "block_bbox": [998, 1297, 1026, 1322], "block_id": 4, "block_order": null, "group_id": 4, "block_polygon_points": [[998.0, 1297.0], [1025.0, 1297.0], [1025.0, 1321.0], [998.0, 1321.0]]}], "layout_det_res": {"boxes": [{"cls_id": 14, "label": "image", "score": 0.9521645903587341, "coordinate": [504, 222, 907, 796], "order": null, "polygon_points": [[504.0, 222.0], [907.0, 222.0], [907.0, 796.0], [504.0, 796.0]]}, {"cls_id": 22, "label": "text", "score": 0.5083640217781067, "coordinate": [483, 834, 933, 980], "order": 1, "polygon_points": [[483.0, 834.0], [933.0, 834.0], [933.0, 980.0], [483.0, 980.0]]}, {"cls_id": 22, "label": "text", "score": 0.9267017245292664, "coordinate": [483, 1030, 937, 1254], "order": 2, "polygon_points": [[483.0, 1030.0], [937.0, 1030.0], [937.0, 1254.0], [483.0, 1254.0]]}, {"cls_id": 23, "label": "vertica